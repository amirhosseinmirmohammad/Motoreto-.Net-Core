@model CartSummaryDto
@{
    ViewData["Title"] = "سبد خرید";
}

<div class="container mt-4 mb-5">
    <h1 class="fs-4 fw-bold mb-4"><i class="bi bi-cart3"></i> سبد خرید</h1>

    @if (Model.IsEmpty)
    {
        <div class="text-center py-5 bg-white rounded-4">
            <i class="bi bi-cart-x fs-1 text-muted"></i>
            <p class="mt-3 text-muted">سبد خرید شما خالی است.</p>
            <a href="/products" class="btn btn-primary">رفتن به فروشگاه</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="list-group list-group-flush" id="cartItems">
                        @foreach (var item in Model.Items)
                        {
                            <div class="list-group-item p-3" data-product-id="@item.ProductId">
                                <div class="d-flex gap-3">
                                    <a href="/p/@item.Slug">
                                        <img src="@item.Image" alt="@item.Name" width="90" height="90" class="rounded-3" loading="lazy" />
                                    </a>
                                    <div class="flex-grow-1">
                                        <a href="/p/@item.Slug" class="text-decoration-none text-dark d-block mb-2">@item.Name</a>

                                        @if (item.Stock < item.Quantity)
                                        {
                                            <div class="stock-warning mb-2"><i class="bi bi-exclamation-triangle"></i> تنها @item.Stock.ToString().ToFarsiDigits() عدد موجود است</div>
                                        }

                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                                            <div class="input-group input-group-sm" style="width: 120px;">
                                                <button class="btn btn-outline-secondary cart-qty" data-action="plus" data-id="@item.ProductId">+</button>
                                                <span class="form-control text-center qty-display">@item.Quantity.ToString().ToFarsiDigits()</span>
                                                <button class="btn btn-outline-secondary cart-qty" data-action="minus" data-id="@item.ProductId">−</button>
                                            </div>

                                            <div class="text-start">
                                                @if (item.DiscountPercent > 0)
                                                {
                                                    <del class="text-muted small d-block">@item.UnitPrice.ToToman()</del>
                                                }
                                                <strong>@item.LineTotal.ToToman()</strong>
                                            </div>

                                            <button class="btn btn-sm btn-outline-danger cart-remove" data-id="@item.ProductId" aria-label="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-3 sticky-top" style="top: 90px;">
                    <h6 class="fw-bold mb-3">خلاصه سفارش</h6>
                    <div class="d-flex justify-content-between py-1">
                        <span class="text-muted">قیمت کالاها (@Model.TotalCount.ToString().ToFarsiDigits())</span>
                        <span>@Model.Subtotal.ToToman()</span>
                    </div>
                    <div class="d-flex justify-content-between py-1 text-danger">
                        <span>تخفیف کالاها</span>
                        <span>@Model.DiscountAmount.ToToman()</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between py-1 fw-bold">
                        <span>جمع سبد خرید</span>
                        <span id="cartTotal">@((Model.Subtotal - Model.DiscountAmount).ToToman())</span>
                    </div>
                    <small class="text-muted mb-3">هزینه ارسال در مرحله بعد محاسبه می‌شود.</small>

                    <form asp-controller="Checkout" asp-action="Start" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary w-100 py-2">
                            ثبت سفارش <i class="bi bi-arrow-left me-1"></i>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>
