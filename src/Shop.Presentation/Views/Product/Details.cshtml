@model ProductDetailPageViewModel
@section Head {
    <title>@ViewData["SeoTitle"]</title>
    <meta name="description" content="@ViewData["SeoDescription"]" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href="@ViewData["SeoUrl"]" />
    <meta property="og:type" content="product" />
    <meta property="og:site_name" content="مارکت" />
    <meta property="og:title" content="@ViewData["SeoTitle"]" />
    <meta property="og:description" content="@ViewData["SeoDescription"]" />
    <meta property="og:image" content="@ViewData["SeoImage"]" />
    <meta property="og:url" content="@ViewData["SeoUrl"]" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json">
        @Html.Raw(ViewData["SeoJsonLd"])
    </script>
}
@{
    var p = Model.Product.Card;
    ViewData["Title"] = p.Name;
    var gallery = Model.Product.Images.Count > 0 ? Model.Product.Images : new List<string> { p.Image };
}

@section Styles {
<style>
    .gallery-thumb { cursor: pointer; border: 2px solid transparent; border-radius: .75rem; }
    .gallery-thumb.active { border-color: var(--brand); }
    .comment-item { border-bottom: 1px solid var(--bs-border-color); }
</style>
}

<div class="container mt-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">خانه</a></li>
            <li class="breadcrumb-item"><a href="/products?category=@Model.Product.BreadCrumbs[0].Slug">@Model.Product.BreadCrumbs[0].Name</a></li>
            @if (Model.Product.BreadCrumbs.Count > 1)
            {
                <li class="breadcrumb-item"><a href="/products?category=@Model.Product.BreadCrumbs[1].Slug">@Model.Product.BreadCrumbs[1].Name</a></li>
            }
            @if (Model.Product.BreadCrumbs.Count > 2)
            {
                <li class="breadcrumb-item active">@Model.Product.BreadCrumbs[2].Name</li>
            }
            else
            {
                <li class="breadcrumb-item active">@p.CategoryName</li>
            }
        </ol>
    </nav>

    <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4">
        <div class="row g-4">
            <div class="col-12 col-md-5">
                <div class="zoom-stage">
                    <img src="@gallery[0]" id="mainImage" class="img-fluid w-100" style="aspect-ratio:1;object-fit:cover" alt="@p.Name" />
                </div>
                @if (gallery.Count > 1)
                {
                    <div class="d-flex gap-2 mt-3 justify-content-center">
                        @foreach (var img in gallery)
                        {
                            <img src="@img" class="gallery-thumb @(img == gallery[0] ? "active" : "")" width="72" height="72" alt="@p.Name" onclick="swapImage(this)" loading="lazy" />
                        }
                    </div>
                }
            </div>

            <div class="col-12 col-md-7 d-flex flex-column">
                <h1 class="fs-4 fw-bold mb-2">@p.Name</h1>
                <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
                    <span class="text-muted small"><i class="bi bi-upc-scan"></i> کد: @Model.Product.Code.ToFarsiDigits()</span>
                    @if (Model.CommentCount > 0)
                    {
                        <span class="small"><i class="bi bi-star-fill text-warning"></i> @Model.AverageRating.ToString("0.0").ToFarsiDigits() (@Model.CommentCount.ToString().ToFarsiDigits() نظر)</span>
                    }
                    <span class="text-muted small"><i class="bi bi-eye"></i> @p.SalesCount.ToString("N0").ToFarsiDigits() فروش</span>
                </div>

                <ul class="list-unstyled text-muted small">
                    <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> اصالت کالا تضمین می‌شود</li>
                    <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> ۷ روز ضمانت بازگشت کالا</li>
                    <li class="mb-1"><i class="bi bi-check2 text-success me-1"></i> ارسال سریع به سراسر کشور</li>
                </ul>

                <div class="mt-auto">
                    <div class="p-3 rounded-4 bg-light">
                        @if (p.DiscountPercent > 0)
                        {
                            <div class="d-flex justify-content-between align-items-center">
                                <del class="text-muted">@p.UnitPrice.ToToman()</del>
                                <span class="discount-badge">@p.DiscountPercent.ToString().ToFarsiDigits()٪</span>
                            </div>
                        }
                        @if (ViewBag.HasVariants is true)
                        {
                            <div id="variantPicker" class="mb-2" data-variants='@Html.Raw(ViewBag.VariantsJson)'></div>
                        }
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-2">
                            <strong class="fs-4" id="pdPrice">@p.FinalPrice.ToToman()</strong>

                            @if (p.Stock <= 0)
                            {
                                <button class="btn btn-secondary" disabled id="pdStockBtn">ناموجود</button>
                            }
                            else
                            {
                                <div class="d-flex gap-2" id="pdCartArea">
                                    <button class="btn btn-light border" id="favBtn" data-id="@p.Id" aria-label="علاقه‌مندی">
                                        <i class="bi bi-heart@(Model.IsFavorite ? "-fill text-danger" : "")"></i>
                                    </button>
                                    <div class="input-group" style="width: 130px;">
                                        <button class="btn btn-outline-secondary" type="button" onclick="changeQty(-1)">−</button>
                                        <input type="number" id="qtyInput" class="form-control text-center" value="1" min="1" max="@Math.Min(Model.MaxQuantityPerProduct, p.Stock)" />
                                        <button class="btn btn-outline-secondary" type="button" onclick="changeQty(1)">+</button>
                                    </div>
                                    <button class="btn btn-primary px-4" id="addToCartBtn" data-id="@p.Id">
                                        <i class="bi bi-cart-plus me-1"></i> افزودن به سبد
                                    </button>
                                </div>
                            }
                        </div>
                        @if (p.Stock > 0 && p.Stock <= Model.LowStockThreshold)
                        {
                            <div class="stock-warning mt-2"><i class="bi bi-exclamation-triangle"></i> تنها @p.Stock.ToString().ToFarsiDigits() عدد در انبار باقی مانده!</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3">معرفی محصول</h5>
                <div class="product-desc">@Html.Raw(Shop.Shared.HtmlSanitizer.Sanitize(Model.Product.Description))</div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
                <h6 class="fw-bold mb-3"><i class="bi bi-geo-alt"></i> مشخصات</h6>
                @{
                    var attrGroups = new List<(string Name, List<string> Values)>();
                    if (!string.IsNullOrWhiteSpace(Model.Product.AttributesJson))
                    {
                        try
                        {
                            var attrOpts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                            var parsed = System.Text.Json.JsonSerializer.Deserialize<List<Shop.Application.DTOs.ProductAttributeGroupDto>>(Model.Product.AttributesJson, attrOpts);
                            foreach (var g in parsed ?? [])
                            {
                                if (!string.IsNullOrEmpty(g.Name) && (g.Values ?? []).Count > 0)
                                    attrGroups.Add((g.Name, g.Values!));
                            }
                        }
                        catch { /* JSON نامعتبر — نادیده گرفته می‌شود */ }
                    }
                }
                <table class="table table-sm">
                    <tr><td class="text-muted">دسته</td><td>@p.CategoryName</td></tr>
                    <tr><td class="text-muted">برند</td><td>@(p.BrandName ?? p.EnglishName)</td></tr>
                    <tr><td class="text-muted">کد کالا</td><td>@Model.Product.Code.ToFarsiDigits()</td></tr>
                    @foreach (var g in attrGroups)
                    {
                        <tr><td class="text-muted">@g.Name</td><td>@string.Join("، ", g.Values)</td></tr>
                    }
                </table>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-chat-square-text"></i> ثبت نظر</h6>
                <div class="mb-2">
                    <label class="small text-muted">امتیاز شما</label>
                    <div class="rating-input" id="ratingInput">
                        @for (var i = 5; i >= 1; i--)
                        {
                            <i class="bi bi-star" data-value="@i" title="@i"></i>
                        }
                    </div>
                </div>
                <textarea class="form-control mb-2" id="commentText" rows="3" placeholder="تجربه خود را بنویسید..."></textarea>
                <button class="btn btn-primary btn-sm w-100" id="commentBtn" data-id="@p.Id">ثبت نظر</button>
            </div>
        </div>
    </div>

    @if (Model.Comments.Count > 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mt-3 mb-5">
            <h5 class="fw-bold mb-3">نظرات کاربران (@Model.CommentCount.ToString().ToFarsiDigits())</h5>
            @foreach (var comment in Model.Comments)
            {
                <div class="comment-item py-3">
                    <div class="d-flex justify-content-between">
                        <strong>@comment.UserName</strong>
                        <span class="small text-warning">@(new string('★', comment.Rating))</span>
                    </div>
                    <p class="mb-1 mt-1">@comment.Text</p>
                    <small class="text-muted">@comment.CreatedAt.ToPersianDate()</small>
                </div>
            }
        </div>
    }

    @if (Model.Related.Count > 0)
    {
        <section class="mb-5">
            <div class="section-head">
                <h2 class="section-title">محصولات مشابه</h2>
            </div>
            <div class="row g-3">
                @foreach (var product in Model.Related)
                {
                    <div class="col-6 col-md-4 col-lg-3 col-xl-2">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            </div>
        </section>
    }
</div>

@section Scripts {
<script>
    var LOW_STOCK = @Model.LowStockThreshold;

    function swapImage(img) {
        document.getElementById('mainImage').src = img.src;
        document.querySelectorAll('.gallery-thumb').forEach(function (t) { t.classList.remove('active'); });
        img.classList.add('active');
    }

    function changeQty(delta) {
        var input = document.getElementById('qtyInput');
        var max = parseInt(input.max) || 1;
        input.value = Math.min(Math.max(1, parseInt(input.value) + delta), max);
    }

    // امتیاز ستاره‌ای
    var selectedRating = 5;
    document.querySelectorAll('#ratingInput i').forEach(function (star) {
        star.addEventListener('click', function () {
            selectedRating = parseInt(this.dataset.value);
            document.querySelectorAll('#ratingInput i').forEach(function (s) {
                var v = parseInt(s.dataset.value);
                s.className = v <= selectedRating ? 'bi bi-star-fill text-warning' : 'bi bi-star';
            });
        });
    });
</script>
}

@if (ViewBag.HasVariants is true)
{
    <script>
    (function () {
        var container = document.getElementById('variantPicker');
        if (!container) return;

        var variants = JSON.parse(container.dataset.variants || '[]');
        if (!variants.length) return;

        // استخراج گروه ویژگی‌ها به ترتیب
        var groups = [], seen = {};
        variants.forEach(function (v) {
            (JSON.parse(v.attributesJson || '[]')).forEach(function (a) {
                if (!seen[a.name]) { seen[a.name] = true; groups.push({ name: a.name, values: [] }); }
            });
        });
        groups.forEach(function (g) {
            var vals = {}, gv = [];
            variants.forEach(function (v) {
                (JSON.parse(v.attributesJson || '[]')).forEach(function (a) {
                    if (a.name === g.name && !vals[a.value]) { vals[a.value] = 1; gv.push(a.value); }
                });
            });
            g.values = gv;
        });

        var selection = {};
        var selectedVariant = null;

        function render() {
            container.innerHTML = '';
            groups.forEach(function (g) {
                var lbl = document.createElement('div');
                lbl.className = 'small fw-bold mb-1';
                lbl.textContent = g.name + ':';
                container.appendChild(lbl);

                var row = document.createElement('div');
                row.className = 'd-flex flex-wrap gap-2 mb-2';
                g.values.forEach(function (val) {
                    var b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'btn btn-sm ' + (selection[g.name] === val ? 'btn-primary' : 'btn-outline-secondary');
                    b.textContent = val;
                    b.addEventListener('click', function () {
                        selection[g.name] = val;
                        render();
                        update();
                    });
                    row.appendChild(b);
                });
                container.appendChild(row);
            });

            var info = document.createElement('div');
            info.className = 'small mb-1';
            if (selectedVariant) {
                info.innerHTML = selectedVariant.available > 0
                    ? '<span class="text-success fw-bold">موجود: ' + selectedVariant.available + ' عدد</span>'
                    : '<span class="text-danger fw-bold">این ترکیب ناموجود است</span>';
            } else {
                info.innerHTML = '<span class="text-danger">این ترکیب موجود نیست — مقدار دیگری انتخاب کنید.</span>';
            }
            container.appendChild(info);
        }

        function update() {
            // پیدا واریانت منطبق با انتخاب فعلی
            selectedVariant = null;
            var keys = Object.keys(selection);
            if (keys.length === groups.length) {
                selectedVariant = variants.find(function (v) {
                    var attrs = {};
                    (JSON.parse(v.attributesJson || '[]')).forEach(function (a) { attrs[a.name] = a.value; });
                    return keys.every(function (k) { return attrs[k] === selection[k]; });
                }) || null;
            }

            // قیمت و دکمه‌ها
            var priceEl = document.getElementById('pdPrice');
            var cartArea = document.getElementById('pdCartArea');
            var stockBtn = document.getElementById('pdStockBtn');

            if (priceEl && selectedVariant) {
                priceEl.textContent = selectedVariant.finalPrice.toLocaleString('fa-IR') + ' تومان';
            }
            if (stockBtn) stockBtn.style.display = (!selectedVariant || selectedVariant.available <= 0) ? '' : 'none';
            if (cartArea) cartArea.style.display = (selectedVariant && selectedVariant.available > 0) ? '' : 'none';

            window.__selectedVariantId = selectedVariant ? selectedVariant.id : null;
        }

        // انتخاب پیش‌فرض: اولین ترکیب موجود
        var first = variants.find(function (v) { return v.available > 0; }) || variants[0];
        if (first) {
            (JSON.parse(first.attributesJson || '[]')).forEach(function (a) { selection[a.name] = a.value; });
        }
        render();
        update();
    })();
    </script>
}