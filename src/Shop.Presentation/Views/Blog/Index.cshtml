@model PagedResult<BlogPostDto>
@{
    ViewData["Title"] = "وبلاگ";
}
<div class="container mt-4 mb-5">
    <h1 class="fs-4 fw-bold mb-4"><i class="bi bi-journal-text"></i> وبلاگ</h1>

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4 text-muted">مقاله‌ای منتشر نشده است.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var post in Model.Items)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <a href="/blog/@post.Slug" class="blog-card h-100">
                        <img src="@post.CoverImage" alt="@post.Title" class="blog-card-img" loading="lazy" />
                        <div class="blog-card-body">
                            <h2 class="blog-card-title">@post.Title</h2>
                            <p class="blog-card-desc">@post.ShortDescription</p>
                            <div class="d-flex justify-content-between small text-muted">
                                <span><i class="bi bi-calendar3"></i> @post.CreatedAt.ToPersianDate()</span>
                                <span><i class="bi bi-eye"></i> @post.ViewCount.ToString("N0").ToFarsiDigits()</span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
        <partial name="_Pagination" model="Model" />
    }
</div>
