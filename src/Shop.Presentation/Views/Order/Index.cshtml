@model PagedResult<OrderListItemDto>
@{
    ViewData["Title"] = "سفارش‌های من";
}

<div class="container mt-4 mb-5">
    <h1 class="fs-4 fw-bold mb-4"><i class="bi bi-box-seam"></i> سفارش‌های من</h1>

    @if (Model.Items.Count == 0)
    {
        <div class="text-center py-5 bg-white rounded-4">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <p class="mt-3 text-muted">هنوز سفارشی ثبت نکرده‌اید.</p>
            <a href="/products" class="btn btn-primary btn-sm">شروع خرید</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>سفارش</th>
                            <th class="d-none d-md-table-cell">تاریخ</th>
                            <th class="d-none d-sm-table-cell">اقلام</th>
                            <th>مبلغ</th>
                            <th>وضعیت</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="@order.FirstItemImage" width="44" height="44" class="rounded-3" alt="" />
                                        <div>
                                            <div class="fw-bold small">@order.OrderNumber.ToFarsiDigits()</div>
                                            <small class="text-muted d-md-none">@order.CreatedAt.ToPersianDate()</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell small">@order.CreatedAt.ToPersianDate()</td>
                                <td class="d-none d-sm-table-cell small">@order.ItemsCount.ToString().ToFarsiDigits() عدد</td>
                                <td class="fw-bold small">@order.Total.ToToman()</td>
                                <td><span class="badge text-bg-@order.StatusBadgeClass">@order.StatusTitle</span></td>
                                <td><a href="/orders/@order.Id" class="btn btn-sm btn-outline-primary">جزئیات</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <partial name="_Pagination" model="Model" />
    }
</div>
