@model OrderDetailDto
@{
    ViewData["Title"] = "جزئیات سفارش " + Model.OrderNumber;
}

<div class="container mt-4 mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h1 class="fs-4 fw-bold mb-0">سفارش @Model.OrderNumber.ToFarsiDigits()</h1>
        <span class="badge text-bg-@Model.StatusBadgeClass fs-6">@Model.StatusTitle</span>
    </div>

    @if (TempData["Success"] is string ok)
    {
        <div class="alert alert-success rounded-4">@ok</div>
    }
    @if (TempData["Error"] is string err)
    {
        <div class="alert alert-danger rounded-4">@err</div>
    }

    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-header bg-white border-0 pt-3 fw-bold">اقلام سفارش</div>
                <div class="list-group list-group-flush">
                    @foreach (var item in Model.Items)
                    {
                        <div class="list-group-item d-flex gap-3 align-items-center">
                            <a href="/p/@item.Slug"><img src="@item.Image" width="64" height="64" class="rounded-3" alt="@item.ProductName" /></a>
                            <div class="flex-grow-1">
                                <a href="/p/@item.Slug" class="text-decoration-none text-dark small">@item.ProductName</a>
                                <div class="text-muted small">@item.Quantity.ToString().ToFarsiDigits() × @item.UnitPrice.ToToman()</div>
                            </div>
                            <strong class="small">@item.LineTotal.ToToman()</strong>
                        </div>
                    }
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="fw-bold mb-2"><i class="bi bi-geo-alt"></i> اطلاعات ارسال</div>
                <div class="row small g-2">
                    <div class="col-6 col-md-3 text-muted">گیرنده</div><div class="col-6 col-md-3">@Model.ReceiverName</div>
                    <div class="col-6 col-md-3 text-muted">تماس</div><div class="col-6 col-md-3">@Model.Phone.ToFarsiDigits()</div>
                    <div class="col-6 col-md-3 text-muted">استان</div><div class="col-6 col-md-3">@Model.StateName</div>
                    <div class="col-6 col-md-3 text-muted">شهر</div><div class="col-6 col-md-3">@Model.CityName</div>
                    <div class="col-6 col-md-3 text-muted">روش ارسال</div><div class="col-6 col-md-3">@Model.ShippingMethodTitle</div>
                    <div class="col-6 col-md-3 text-muted">روش پرداخت</div><div class="col-6 col-md-3">@Model.PaymentMethodTitle</div>
                    <div class="col-12"><span class="text-muted">آدرس: </span>@Model.Address</div>
                    @if (!string.IsNullOrEmpty(Model.Note))
                    {
                        <div class="col-12"><span class="text-muted">توضیحات: </span>@Model.Note</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="fw-bold mb-3">خلاصه پرداخت</div>
                <div class="d-flex justify-content-between small py-1"><span class="text-muted">جمع کالاها</span><span>@Model.Subtotal.ToToman()</span></div>
                @if (Model.DiscountAmount > 0)
                {
                    <div class="d-flex justify-content-between small py-1 text-danger"><span>تخفیف @(Model.DiscountCode is null ? "" : $"({Model.DiscountCode})")</span><span>@Model.DiscountAmount.ToToman()−</span></div>
                }
                <div class="d-flex justify-content-between small py-1"><span class="text-muted">ارسال</span><span>@(Model.ShippingCost == 0 ? "رایگان" : Model.ShippingCost.ToToman())</span></div>
                <hr class="my-2" />
                <div class="d-flex justify-content-between fw-bold"><span>مبلغ کل</span><span>@Model.Total.ToToman()</span></div>
                <div class="small text-muted mt-2"><i class="bi bi-calendar3"></i> ثبت: @Model.CreatedAt.ToPersianDateTime()</div>
                @if (Model.PaidAt is not null)
                {
                    <div class="small text-success"><i class="bi bi-check2-circle"></i> پرداخت: @Model.PaidAt.Value.ToPersianDateTime()</div>
                }

                @if (Model.StatusTitle == "در انتظار پرداخت")
                {
                    <a href="/payment/pay/@Model.Id" class="btn btn-primary w-100 mt-3">ادامه پرداخت</a>
                }
                @if (Model.StatusTitle is "پرداخت شده" or "در حال پردازش")
                {
                    <form asp-controller="Order" asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="mt-3"
                          onsubmit="return confirm('سفارش لغو شود؟')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reason" value="لغو توسط کاربر" />
                        <button type="submit" class="btn btn-outline-danger w-100 btn-sm">لغو سفارش</button>
                    </form>
                }
                <a href="/orders" class="btn btn-link btn-sm w-100 text-decoration-none mt-2">بازگشت به سفارش‌ها</a>
            </div>
        </div>
    </div>
</div>
