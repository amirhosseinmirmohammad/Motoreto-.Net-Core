@model dynamic
@{
    var query = Context.Request.Query.ToDictionary(k => k.Key, v => v.Value.ToString());
    Func<int, string> url = p =>
    {
        query["page"] = p.ToString();
        var qs = string.Join("&", query.Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value)}"));
        return Context.Request.Path + "?" + qs;
    };
    int page = Model.Page;
    int totalPages = Model.TotalPages;
    bool hasPrevious = Model.HasPrevious;
    bool hasNext = Model.HasNext;
}
@if (totalPages > 1)
{
    <nav class="mt-4" aria-label="صفحه‌بندی">
        <ul class="pagination justify-content-center">
            <li class="page-item @(hasPrevious ? "" : "disabled")">
                <a class="page-link" href="@url(page - 1)"><i class="bi bi-chevron-right"></i></a>
            </li>
            @for (var i = Math.Max(1, page - 2); i <= Math.Min(totalPages, page + 2); i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" href="@url(i)">@i.ToString().ToFarsiDigits()</a>
                </li>
            }
            <li class="page-item @(hasNext ? "" : "disabled")">
                <a class="page-link" href="@url(page + 1)"><i class="bi bi-chevron-left"></i></a>
            </li>
        </ul>
    </nav>
}
