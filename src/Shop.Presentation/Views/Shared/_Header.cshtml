@using Shop.Presentation.Services
@inject ISettingsService SettingsService
@inject Shop.Application.Interfaces.ICartService CartService
@inject Shop.Application.Interfaces.ICategoryService CategoryService
@inject IGuestCartAccessor GuestCart
@{
    var settings = await SettingsService.GetAsync();
    var menu = await CategoryService.GetMenuAsync();
    int cartCount;
    if (User.Identity?.IsAuthenticated == true)
    {
        var uid = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        cartCount = Guid.TryParse(uid, out var id)
            ? (await CartService.GetSummaryAsync(id, null)).TotalCount
            : 0;
    }
    else
    {
        cartCount = (await CartService.GetSummaryAsync(null, GuestCart.GetToken())).TotalCount;
    }
}
<header class="site-header">
    <div class="container">
        <div class="header-top d-flex align-items-center gap-3 py-3">
            <button class="btn btn-icon d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-label="منو">
                <i class="bi bi-list fs-4"></i>
            </button>

            <a href="/" class="brand d-flex align-items-center gap-2 text-decoration-none">
                <span class="brand-logo"><i class="bi bi-bag-heart-fill"></i></span>
                <span class="brand-name d-none d-sm-block">@settings.StoreName</span>
            </a>

            <form class="search-box flex-grow-1" action="/products" method="get" role="search">
                <div class="position-relative">
                    <input type="search" name="q" class="form-control search-input" placeholder="جستجو در محصولات..." value="@Context.Request.Query["q"]" autocomplete="off" />
                    <i class="bi bi-search search-icon"></i>
                    <div class="suggest-box d-none" id="searchSuggest"></div>
                </div>
            </form>

            <div class="header-actions d-flex align-items-center gap-2">
                <a href="/cart" class="btn btn-icon position-relative" aria-label="سبد خرید">
                    <i class="bi bi-cart3 fs-5"></i>
                    <span class="cart-badge @(cartCount > 0 ? "" : "d-none")" id="cartBadge">@cartCount.ToString().ToFarsiDigits()</span>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="btn btn-user dropdown-toggle" data-bs-toggle="dropdown">
                            <i class="bi bi-person-circle me-1"></i>
                            <span class="d-none d-md-inline">حساب کاربری</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/panel"><i class="bi bi-house-door me-2"></i>پنل کاربری</a></li>
                            <li><a class="dropdown-item" href="/orders"><i class="bi bi-box-seam me-2"></i>سفارش‌های من</a></li>
                            <li><a class="dropdown-item" href="/favorites"><i class="bi bi-heart me-2"></i>علاقه‌مندی‌ها</a></li>
                            @if (User.IsInRole("Administrator"))
                            {
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" href="/admin"><i class="bi bi-speedometer2 me-2"></i>پنل مدیریت</a></li>
                            }
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-left me-2"></i>خروج</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a href="/account/login" class="btn btn-user">
                        <i class="bi bi-person me-1"></i>
                        <span class="d-none d-md-inline">ورود | ثبت‌نام</span>
                    </a>
                }
            </div>
        </div>
    </div>

    <nav class="header-nav d-none d-lg-block">
        <div class="container">
            <ul class="nav-menu">
                @foreach (var cat in menu)
                {
                    <li class="has-sub">
                        <a href="/products?category=@cat.Slug">
                            @if (!string.IsNullOrEmpty(cat.Icon))
                            {
                                <i class="bi @cat.Icon me-1"></i>
                            }
                            @cat.Name
                        </a>
                        @if (cat.Children.Count > 0)
                        {
                            <div class="submenu">
                                <div class="submenu-head">@cat.Name</div>
                                @foreach (var child in cat.Children)
                                {
                                    <a href="/products?category=@child.Slug">@child.Name</a>
                                    @foreach (var gc in child.Children)
                                    {
                                        <a href="/products?category=@gc.Slug" style="padding-inline-start:1.6rem;font-size:.8rem;color:#888">@gc.Name</a>
                                    }
                                }
                                <a href="/products?category=@cat.Slug" class="submenu-all">مشاهده همه <i class="bi bi-chevron-left"></i></a>
                            </div>
                        }
                    </li>
                }
                <li><a href="/blog">وبلاگ</a></li>
                <li><a href="/about">درباره ما</a></li>
                <li><a href="/contact">تماس با ما</a></li>
            </ul>
        </div>
    </nav>
</header>

<div class="offcanvas offcanvas-end" tabindex="-1" id="mobileMenu">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">@settings.StoreName</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <a href="/products" class="mobile-link"><i class="bi bi-grid me-2"></i>همه محصولات</a>
        <a href="/blog" class="mobile-link"><i class="bi bi-journal-text me-2"></i>وبلاگ</a>
        <a href="/about" class="mobile-link"><i class="bi bi-info-circle me-2"></i>درباره ما</a>
        <a href="/contact" class="mobile-link"><i class="bi bi-headset me-2"></i>تماس با ما</a>
        <hr />
        @foreach (var cat in menu)
        {
            <div class="mobile-cat">
                <a href="/products?category=@cat.Slug" class="mobile-link fw-bold">
                    @if (!string.IsNullOrEmpty(cat.Icon))
                    {
                        <i class="bi @cat.Icon me-2"></i>
                    }
                    @cat.Name
                </a>
                @foreach (var child in cat.Children)
                {
                    <a href="/products?category=@child.Slug" class="mobile-link sub">@child.Name</a>
                }
            </div>
        }
    </div>
</div>
