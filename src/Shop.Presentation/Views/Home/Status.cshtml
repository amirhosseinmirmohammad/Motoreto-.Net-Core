@{
    var code = Context.Items["Code"]?.ToString() ?? "500";
    var is404 = code == "404";
    ViewData["Title"] = is404 ? "صفحه پیدا نشد" : "خطای " + code.ToFarsiDigits();
}
@section Styles {
<style>
    .error-hero {
        max-width: 560px; margin: 4rem auto 3rem; text-align: center;
        background: #fff; border-radius: 24px; padding: 3rem 2rem;
        box-shadow: 0 8px 30px rgba(35,37,78,.08);
    }
    .error-code {
        font-size: 5rem; font-weight: 900; line-height: 1;
        background: linear-gradient(135deg, var(--brand), #b3123c);
        -webkit-background-clip: text; background-clip: text; color: transparent;
    }
    .error-actions { display: flex; gap: .75rem; justify-content: center; margin-top: 1.5rem; flex-wrap: wrap; }
    .error-links { margin-top: 2rem; display: flex; gap: .5rem; justify-content: center; flex-wrap: wrap; }
    .error-links a {
        padding: .45rem 1rem; background: var(--bg); border-radius: 999px;
        font-size: .82rem; color: var(--ink); text-decoration: none;
    }
    .error-links a:hover { background: var(--brand-soft); color: var(--brand); }
    @@keyframes float { 0%,100% { transform: translateY(0) } 50% { transform: translateY(-8px) } }
    .error-icon { font-size: 3.5rem; animation: float 3s ease-in-out infinite; }
</style>
}
<div class="error-hero">
    <div class="error-icon">@(is404 ? "🛰️" : "🧯")</div>
    <div class="error-code mt-3">@(is404 ? "۴۰۴" : code.ToFarsiDigits())</div>

    @if (is404)
    {
        <h1 class="fs-3 fw-bold mt-2">این صفحه وجود ندارد!</h1>
        <p class="text-muted">ممکن است آدرس عوض شده یا کالا حذف شده باشد؛ ولی نگران نباش، همه‌چیز سر جاشه:</p>
    }
    else
    {
        <h1 class="fs-3 fw-bold mt-2">ای وای، خطایی پیش آمد!</h1>
        <p class="text-muted">مشکلی از سمت ما رخ داد. لطفاً دوباره تلاش کنید؛ اگر تکرار شد به ما خبر بدهید.</p>
    }

    <div class="error-actions">
        <a href="/" class="btn btn-primary px-4">بازگشت به فروشگاه</a>
        @if (!is404)
        {
            <a href="javascript:location.reload()" class="btn btn-outline-secondary px-4">تلاش مجدد</a>
        }
    </div>

    <div class="error-links">
        <a href="/products"><i class="bi bi-grid me-1"></i>همه محصولات</a>
        <a href="/products?sort=discount"><i class="bi bi-lightning-charge me-1"></i>شگفت‌انگیزها</a>
        <a href="/orders"><i class="bi bi-box-seam me-1"></i>سفارش‌های من</a>
        <a href="/contact"><i class="bi bi-headset me-1"></i>پشتیبانی</a>
    </div>
</div>
