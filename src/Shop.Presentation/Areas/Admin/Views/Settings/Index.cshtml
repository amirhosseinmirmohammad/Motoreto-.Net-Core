@model SiteSettings
@{
    ViewData["Title"] = "تنظیمات فروشگاه";
}
<div class="card" style="max-width: 760px;">
    <form method="post" action="/admin/settings">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" style="color:var(--red);font-size:12.5px;"></div>

        <h3 style="font-size:14px;margin:6px 0 0;">🌐 فرانت‌اند و CORS</h3>
        <div class="form-row">
            <div>
                <label>آدرس فرانت‌اند</label>
                <input type="url" asp-for="FrontendUrl" dir="ltr" placeholder="https://example.ir" />
            </div>
            <div>
                <label>دامین‌های اضافه (کاما جداکنید)</label>
                <input type="text" asp-for="AdditionalCorsOrigins" dir="ltr" placeholder="https://app.example.ir, https://admin.example.ir" />
            </div>
        </div>
        <div class="text-muted2">وقتی API روی ساب‌دامین جدا است (مثل api.example.ir)، آدرس فرانت‌اند را وارد کنید.</div>

        <h3 style="font-size:14px;margin:6px 0 0;">🏪 هویت فروشگاه</h3>
        <div class="form-row">
            <div>
                <label>نام فروشگاه</label>
                <input type="text" asp-for="StoreName" />
            </div>
            <div>
                <label>شعار</label>
                <input type="text" asp-for="Tagline" />
            </div>
        </div>
        <div class="form-row">
            <div>
                <label>رنگ اصلی (hex)</label>
                <input type="text" asp-for="PrimaryColor" dir="ltr" />
            </div>
            <div>
                <label>درگاه پرداخت فعال (Fake / ...)</label>
                <input type="text" asp-for="PaymentGateway" dir="ltr" />
            </div>
        </div>

        <h3 style="font-size:14px;margin-top:18px;">📞 تماس</h3>
        <div class="form-row">
            <div>
                <label>تلفن پشتیبانی</label>
                <input type="text" asp-for="SupportPhone" dir="ltr" />
            </div>
            <div>
                <label>ایمیل</label>
                <input type="email" asp-for="Email" dir="ltr" />
            </div>
        </div>
        <label>آدرس</label>
        <input type="text" asp-for="Address" />

        <div class="form-row">
            <div>
                <label>اینستاگرام</label>
                <input type="url" asp-for="InstagramUrl" dir="ltr" />
            </div>
            <div>
                <label>تلگرام</label>
                <input type="url" asp-for="TelegramUrl" dir="ltr" />
            </div>
        </div>

        <h3 style="font-size:14px;margin-top:18px;">🚚 ارسال (تومان)</h3>
        <div class="form-row">
            <div>
                <label>هزینه پست پیشتاز</label>
                <input type="number" asp-for="ShippingPostCost" min="0" />
            </div>
            <div>
                <label>هزینه اکسپرس</label>
                <input type="number" asp-for="ShippingExpressCost" min="0" />
            </div>
        </div>
        <div class="form-row">
            <div>
                <label>سقف ارسال رایگان (۰ = غیرفعال)</label>
                <input type="number" asp-for="FreeShippingThreshold" min="0" />
            </div>
            <div>
                <label>آستانه هشدار موجودی کم</label>
                <input type="number" asp-for="LowStockThreshold" min="1" />
            </div>
        </div>

        <h3 style="font-size:14px;margin-top:18px;">⏱ رزرو موجودی</h3>
        <div class="form-row">
            <div>
                <label>مدت رزرو در تسویه (دقیقه)</label>
                <input type="number" asp-for="ReservationMinutes" min="5" max="120" />
            </div>
            <div>
                <label>حداکثر تعداد هر محصول در سفارش</label>
                <input type="number" asp-for="MaxQuantityPerProduct" min="1" max="20" />
            </div>
        </div>
        <div class="form-row">
            <div>
                <label>فاصله پاکسازی رزروهای منقضی (ثانیه)</label>
                <input type="number" asp-for="ReservationCleanupIntervalSeconds" min="15" />
            </div>
            <div>
                <label>&nbsp;</label>
                <div class="checkbox-row">
                    <input type="checkbox" asp-for="IsMaintenanceMode" />
                    <label style="margin:0;color:var(--ink)">حالت تعمیر و نگهداری</label>
                </div>
            </div>
        </div>

        <h3 style="font-size:14px;margin-top:18px;">📄 صفحات</h3>
        <label>متن درباره ما</label>
        <textarea asp-for="AboutUs" rows="4"></textarea>
        <label>متن تماس با ما</label>
        <textarea asp-for="ContactUs" rows="3"></textarea>

        <div class="mt">
            <button class="btn">💾 ذخیره تنظیمات</button>
        </div>
    </form>
</div>
