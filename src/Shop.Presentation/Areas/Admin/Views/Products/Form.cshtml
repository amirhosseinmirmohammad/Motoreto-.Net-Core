@model AdminProductViewModel
@{
    ViewData["Title"] = "محصول جدید";
    var categories = ViewBag.Categories as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var isEdit = Model.Id > 0;
}
<div class="card" style="max-width: 860px;">
    <form method="post" action="@(isEdit ? $"/admin/products/edit/{Model.Id}" : "/admin/products/create")">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" style="color:var(--red);font-size:12.5px;"></div>

        <div class="form-row">
            <div>
                <label>نام محصول</label>
                <input type="text" asp-for="Name" />
            </div>
            <div>
                <label>نام انگلیسی / برند</label>
                <input type="text" asp-for="EnglishName" dir="ltr" />
            </div>
        </div>

        <div class="form-row">
            <div>
                <label>اسلاگ (خالی = خودکار)</label>
                <input type="text" asp-for="Slug" dir="ltr" />
            </div>
            <div>
                <label>کد کالا (خالی = خودکار)</label>
                <input type="text" asp-for="Code" dir="ltr" />
            </div>
        </div>

        <div class="form-row">
            <div>
                <label>دسته‌بندی</label>
                <select asp-for="CategoryId">
                    @if (categories != null)
                    {
                        @foreach (var c in categories)
                        {
                            <option value="@c.Value">@c.Text</option>
                        }
                    }
                </select>
            </div>
            <div>
                <label>تصویر اصلی (مسیر)</label>
                <input type="text" asp-for="MainImage" dir="ltr" placeholder="/images/products/..." />
            </div>
        </div>

        <div class="form-row">
            <div>
                <label>برند</label>
                <select asp-for="BrandId">
                    @if (ViewBag.Brands is List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> brands)
                    {
                        @foreach (var b in brands)
                        {
                            <option value="@b.Value" selected="@(Model.BrandId?.ToString() == b.Value)">@b.Text</option>
                        }
                    }
                </select>
            </div>
            <div></div>
        </div>

        <label style="margin-top:14px;display:block;">ویژگی‌ها (مقادیر چندتایی با ویرگول — مثلاً رنگ: آبی, مشکی)</label>
        <div id="attrRows">
            @if (ViewBag.AttrRows is List<(string Name, string Values)> attrRows)
            {
                @foreach (var r in attrRows)
                {
                    <div class="form-row attr-row">
                        <div><input type="text" name="AttrNames" value="@r.Name" placeholder="نام ویژگی" /></div>
                        <div><input type="text" name="AttrValues" value="@r.Values" placeholder="مقدار / مقادیر" /></div>
                        <button type="button" onclick="this.closest('.attr-row').remove()">×</button>
                    </div>
                }
            }
        </div>
        <button type="button" onclick="addAttrRow()">+ افزودن ویژگی</button>
        <script>
            function addAttrRow() {
                var d = document.createElement('div');
                d.className = 'form-row attr-row';
                d.innerHTML = '<div><input type="text" name="AttrNames" placeholder="نام ویژگی" /></div>' +
                              '<div><input type="text" name="AttrValues" placeholder="مقدار / مقادیر" /></div>' +
                              '<button type="button" onclick="this.closest(\'.attr-row\').remove()">×</button>';
                document.getElementById('attrRows').appendChild(d);
            }
        </script>

        <div class="form-row">
            <div>
                <label>قیمت (تومان)</label>
                <input type="number" asp-for="UnitPrice" min="0" />
            </div>
            <div>
                <label>درصد تخفیف (۰ تا ۹۰)</label>
                <input type="number" asp-for="DiscountPercent" min="0" max="90" />
            </div>
        </div>

        <div class="form-row">
            <div>
                <label>موجودی انبار</label>
                <input type="number" asp-for="Stock" min="0" />
            </div>
            <div>
                <label>پایان شگفت‌انگیز (در صورت فعال بودن)</label>
                <input type="datetime-local" asp-for="AmazingEndsAt" />
            </div>
        </div>

        <label>توضیحات (HTML)</label>
        <textarea asp-for="Description" rows="8"></textarea>

        <label>گالری (هر خط یک آدرس تصویر)</label>
        <textarea asp-for="GalleryUrls" rows="3" dir="ltr"></textarea>

        <div class="checkbox-row">
            <input type="checkbox" asp-for="IsActive" />
            <label style="margin:0;color:var(--ink)">فعال و قابل نمایش</label>
        </div>
        <div class="checkbox-row">
            <input type="checkbox" asp-for="IsSpecial" />
            <label style="margin:0;color:var(--ink)">انتخاب ادیتور (ویژه)</label>
        </div>
        <div class="checkbox-row">
            <input type="checkbox" asp-for="IsAmazing" />
            <label style="margin:0;color:var(--ink)">پیشنهاد شگفت‌انگیز</label>
        </div>

        <div class="mt" style="display:flex;gap:8px;">
            <button class="btn">@(isEdit ? "ذخیره تغییرات" : "ایجاد محصول")</button>
            <a href="/admin/products" class="btn btn-light">انصراف</a>
        </div>
    </form>
</div>
