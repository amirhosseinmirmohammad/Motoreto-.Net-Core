@model dynamic
@{
    ViewData["Title"] = "کاربران";
}
@functions {
    private static string Fa(object? value) => Shop.Shared.PersianDateHelper.ToFarsiDigits(value?.ToString() ?? string.Empty);
}
@{
    ViewData["Title"] = "کاربران";
    var q = ViewBag.Q as string;
    var page = (int)ViewBag.Page;
    var pageSize = (int)ViewBag.PageSize;
    var total = (int)ViewBag.TotalCount;
    var totalPages = (int)Math.Ceiling(total / (double)pageSize);
}
<div class="toolbar">
    <form method="get">
        <input type="text" name="q" value="@q" placeholder="جستجو ایمیل/نام/موبایل" style="width:240px" />
        <button class="btn btn-light">جستجو</button>
    </form>
</div>
<div class="table-wrap">
    <table>
        <thead><tr><th>نام</th><th>ایمیل</th><th>موبایل</th><th>سفارش‌ها</th><th>عضویت</th><th>وضعیت</th><th>عملیات</th></tr></thead>
        <tbody>
            @foreach (var u in Model)
            {
                <tr>
                    <td style="font-weight:600">@u.FirstName @u.LastName</td>
                    <td dir="ltr" class="text-muted2">@u.Email</td>
                    <td>@(string.IsNullOrEmpty(u.Mobile) ? "—" : Fa(u.Mobile))</td>
                    <td>@Fa(u.OrdersCount)</td>
                    <td class="text-muted2">@Fa(u.CreatedAt)</td>
                    <td>@(u.IsActive ? Html.Raw("<span class='badge badge-green'>فعال</span>") : Html.Raw("<span class='badge badge-red'>غیرفعال</span>"))</td>
                    <td>
                        <form method="post" action="/admin/users/toggle/@u.Id">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-sm btn-light">@(u.IsActive ? "غیرفعال‌سازی" : "فعال‌سازی")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
@if (totalPages > 1)
{
    <div class="pager">
        @for (var i = 1; i <= totalPages; i++)
        {
            if (i == page)
            {
                <span class="current">@i.ToString().ToFarsiDigits()</span>
            }
            else
            {
                <a href="/admin/users?page=@i&q=@q">@i.ToString().ToFarsiDigits()</a>
            }
        }
    </div>
}
