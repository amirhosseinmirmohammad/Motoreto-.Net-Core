<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#1a1c2e" />
    <title>@ViewData["Title"] - پنل مدیریت</title>
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-brand">⚙️ <span>پنل مدیریت</span></div>
        <nav class="sidebar-nav">
            <a href="/admin" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")"><span>📊</span> داشبورد</a>
            <a href="/admin/products" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "")"><span>📦</span> محصولات</a>
            <a href="/admin/categories" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Categories" ? "active" : "")"><span>🗂️</span> دسته‌بندی‌ها</a>

            <a href="/admin/categoryattributes" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "CategoryAttributes" ? "active" : "")"><span>🎛️</span> ویژگی‌های دسته‌ها</a>
            <a href="/admin/orders" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")"><span>🧾</span> سفارش‌ها</a>
            <a href="/admin/users" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "")"><span>👥</span> کاربران</a>
            <a href="/admin/comments" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Comments" ? "active" : "")"><span>💬</span> نظرات</a>
            <a href="/admin/blogcomments" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Messages" && ViewContext.RouteData.Values["action"]?.ToString() == "BlogComments" ? "active" : "")"><span>📝</span> نظرات وبلاگ</a>
            <a href="/admin/discounts" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Discounts" ? "active" : "")"><span>🏷️</span> کد تخفیف</a>
            <a href="/admin/sliders" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Sliders" ? "active" : "")"><span>🖼️</span> اسلایدرها</a>
            <a href="/admin/blogs" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Blogs" ? "active" : "")"><span>📰</span> وبلاگ</a>
            <a href="/admin/messages" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Messages" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"><span>✉️</span> پیام‌ها</a>
            <a href="/admin/newsletter" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Messages" && ViewContext.RouteData.Values["action"]?.ToString() == "Newsletter" ? "active" : "")"><span>📧</span> خبرنامه</a>
            <a href="/admin/settings" class="@(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "")"><span>⚙️</span> تنظیمات</a>
        </nav>
        <div class="sidebar-footer">
            <a href="/" target="_blank">🏠 مشاهده فروشگاه</a>
        </div>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <main class="admin-main">
        <header class="admin-topbar">
            <button class="menu-toggle" id="menuToggle">☰</button>
            <h1 class="page-title">@ViewData["Title"]</h1>
        </header>

        @if (TempData["Success"] is string ok)
        {
            <div class="alert alert-success">@ok</div>
        }
        @if (TempData["Error"] is string err)
        {
            <div class="alert alert-danger">@err</div>
        }

        @RenderBody()
    </main>

    <script src="~/js/farsi-digits.js?v=1"></script>
    <script src="~/js/farsi-digits.js?v=1"></script>
    <script src="~/js/admin.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
