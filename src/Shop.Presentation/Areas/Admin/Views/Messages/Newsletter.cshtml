@model List<NewsLetterSubscriber>
@{
    ViewData["Title"] = "خبرنامه";
}
<div class="card">
    <strong>مشترکان خبرنامه (@Model.Count.ToString().ToFarsiDigits() نفر)</strong>
    <table class="mt">
        <thead><tr><th>ایمیل</th><th>تاریخ عضویت</th></tr></thead>
        <tbody>
            @foreach (var n in Model)
            {
                <tr>
                    <td dir="ltr">@n.Email</td>
                    <td class="text-muted2">@n.SubscribedAt.ToPersianDate()</td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Count == 0)
    {
        <div class="empty">مشترکی وجود ندارد.</div>
    }
</div>
