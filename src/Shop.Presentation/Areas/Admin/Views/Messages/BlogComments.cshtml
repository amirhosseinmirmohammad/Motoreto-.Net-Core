@model List<BlogCommentDto>
@{
    ViewData["Title"] = "نظرات وبلاگ";
    var approved = ViewBag.Approved as bool?;
}
<div class="toolbar">
    <a href="/admin/blogcomments" class="btn btn-light">همه</a>
    <a href="/admin/blogcomments?approved=false" class="btn btn-amber">در انتظار تأیید</a>
    <a href="/admin/blogcomments?approved=true" class="btn btn-green">تأییدشده</a>
</div>
<div class="table-wrap">
    <table>
        <thead><tr><th>نویسنده</th><th>مقاله</th><th>متن</th><th>تاریخ</th><th>وضعیت</th><th>عملیات</th></tr></thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td style="font-weight:600">@c.FullName</td>
                    <td class="text-muted2" style="white-space:normal;max-width:180px">@c.BlogTitle</td>
                    <td style="white-space:normal;max-width:300px">@c.Text</td>
                    <td class="text-muted2">@c.CreatedAt.ToPersianDate()</td>
                    <td>@(c.IsApproved ? Html.Raw("<span class='badge badge-green'>تأیید</span>") : Html.Raw("<span class='badge badge-amber'>انتظار</span>"))</td>
                    <td>
                        <div style="display:flex;gap:4px;">
                            @if (!c.IsApproved)
                            {
                                <form method="post" action="/admin/messages/approveblogcomment/@c.Id">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-green">تأیید</button>
                                </form>
                            }
                            <form method="post" action="/admin/messages/deleteblogcomment/@c.Id" data-confirm="نظر حذف شود؟">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-danger">حذف</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Count == 0)
    {
        <div class="empty">نظری یافت نشد.</div>
    }
</div>
