@model List<SiteMessage>
@{
    ViewData["Title"] = "پیام‌های تماس";
}
<div class="table-wrap">
    <table>
        <thead><tr><th>فرستنده</th><th>ایمیل</th><th>موضوع</th><th>متن</th><th>تاریخ</th><th>وضعیت</th><th>عملیات</th></tr></thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td style="font-weight:600">@m.FullName</td>
                    <td dir="ltr" class="text-muted2">@m.Email</td>
                    <td>@m.Subject</td>
                    <td style="white-space:normal;max-width:280px" class="text-muted2">@m.Body</td>
                    <td class="text-muted2">@m.CreatedAt.ToPersianDate()</td>
                    <td>@(m.IsRead ? Html.Raw("<span class='badge badge-gray'>خوانده</span>") : Html.Raw("<span class='badge badge-blue'>جدید</span>"))</td>
                    <td>
                        @if (!m.IsRead)
                        {
                            <form method="post" action="/admin/messages/markread/@m.Id">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-sm btn-light">خوانده شد</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Count == 0)
    {
        <div class="empty">پیامی وجود ندارد.</div>
    }
</div>
