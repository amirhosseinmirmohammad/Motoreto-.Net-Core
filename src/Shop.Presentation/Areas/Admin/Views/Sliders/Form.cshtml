@model Slider
@{
    ViewData["Title"] = Model.Id > 0 ? "ویرایش اسلایدر" : "اسلایدر جدید";
    var isEdit = Model.Id > 0;
}
<div class="card" style="max-width: 620px;">
    <form method="post" action="@(isEdit ? $"/admin/sliders/edit/{Model.Id}" : "/admin/sliders/create")">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" style="color:var(--red);font-size:12.5px;"></div>

        <div class="form-row">
            <div>
                <label>عنوان</label>
                <input type="text" asp-for="Title" />
            </div>
            <div>
                <label>زیرعنوان</label>
                <input type="text" asp-for="SubTitle" />
            </div>
        </div>

        <label>آدرس تصویر</label>
        <input type="text" asp-for="Image" dir="ltr" placeholder="/images/sliders/..." />

        <div class="form-row">
            <div>
                <label>لینک (اختیاری)</label>
                <input type="text" asp-for="Link" dir="ltr" />
            </div>
            <div>
                <label>رنگ تم (hex)</label>
                <input type="text" asp-for="Theme" dir="ltr" placeholder="#ef4056" />
            </div>
        </div>

        <label>ترتیب نمایش</label>
        <input type="number" asp-for="SortOrder" />

        <div class="checkbox-row">
            <input type="checkbox" asp-for="IsActive" />
            <label style="margin:0;color:var(--ink)">فعال</label>
        </div>

        <div class="mt" style="display:flex;gap:8px;">
            <button class="btn">ذخیره</button>
            <a href="/admin/sliders" class="btn btn-light">انصراف</a>
        </div>
    </form>
</div>
