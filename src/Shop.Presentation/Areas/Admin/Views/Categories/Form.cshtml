@model AdminCategoryViewModel
@{
    ViewData["Title"] = Model.Id > 0 ? "ویرایش دسته" : "دسته جدید";
    var parents = ViewBag.Parents as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>;
    var isEdit = Model.Id > 0;
}
<div class="card" style="max-width: 560px;">
    <form method="post" action="@(isEdit ? $"/admin/categories/edit/{Model.Id}" : "/admin/categories/create")">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" style="color:var(--red);font-size:12.5px;"></div>

        <label>نام دسته</label>
        <input type="text" asp-for="Name" />

        <label>اسلاگ (خالی = خودکار)</label>
        <input type="text" asp-for="Slug" dir="ltr" />

        <label>دسته والد</label>
        <select asp-for="ParentId">
            @if (parents != null)
            {
                @foreach (var p in parents)
                {
                    <option value="@p.Value">@p.Text</option>
                }
            }
        </select>

        <div class="form-row">
            <div>
                <label>آیکون Bootstrap Icons (مثل bi-phone)</label>
                <input type="text" asp-for="Icon" dir="ltr" />
            </div>
            <div>
                <label>ترتیب نمایش</label>
                <input type="number" asp-for="SortOrder" />
            </div>
        </div>

        <div class="checkbox-row">
            <input type="checkbox" asp-for="IsActive" />
            <label style="margin:0;color:var(--ink)">فعال</label>
        </div>

        <div class="mt" style="display:flex;gap:8px;">
            <button class="btn">ذخیره</button>
            <a href="/admin/categories" class="btn btn-light">انصراف</a>
        </div>
    </form>
</div>
