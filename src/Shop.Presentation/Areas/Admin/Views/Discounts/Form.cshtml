@model Discount
@{
    ViewData["Title"] = Model.Id > 0 ? "ویرایش کد تخفیف" : "کد تخفیف جدید";
    var isEdit = Model.Id > 0;
}
<div class="card" style="max-width: 560px;">
    <form method="post" action="@(isEdit ? $"/admin/discounts/edit/{Model.Id}" : "/admin/discounts/create")">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" style="color:var(--red);font-size:12.5px;"></div>

        <div class="form-row">
            <div>
                <label>کد (لاتین، خودکار بزرگ می‌شود)</label>
                <input type="text" asp-for="Code" dir="ltr" />
            </div>
            <div>
                <label>درصد تخفیف</label>
                <input type="number" asp-for="Percent" min="1" max="100" />
            </div>
        </div>

        <label>عنوان</label>
        <input type="text" asp-for="Title" />

        <div class="form-row">
            <div>
                <label>حداکثر تخفیف (تومان، خالی = بی‌نهایت)</label>
                <input type="number" asp-for="MaxAmount" min="0" />
            </div>
            <div>
                <label>حداقل مبلغ سفارش (تومان)</label>
                <input type="number" asp-for="MinOrderAmount" min="0" />
            </div>
        </div>

        <div class="form-row">
            <div>
                <label>سقف تعداد مصرف (خالی = بی‌نهایت)</label>
                <input type="number" asp-for="UsageLimit" min="1" />
            </div>
            <div>
                <label>تاریخ انقضا</label>
                <input type="datetime-local" asp-for="ExpireAt" />
            </div>
        </div>

        <div class="checkbox-row">
            <input type="checkbox" asp-for="IsActive" />
            <label style="margin:0;color:var(--ink)">فعال</label>
        </div>

        <div class="mt" style="display:flex;gap:8px;">
            <button class="btn">ذخیره</button>
            <a href="/admin/discounts" class="btn btn-light">انصراف</a>
        </div>
    </form>
</div>
