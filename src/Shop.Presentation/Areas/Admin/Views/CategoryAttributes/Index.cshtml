@model List<Shop.Domain.CategoryAttribute>
@{
    ViewData["Title"] = "ویژگی‌های دسته‌بندی";
}

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <h4 class="mb-0">ویژگی‌های دسته‌بندی</h4>
    <span class="small text-muted">این ویژگی‌ها به‌صورت خودکار در فیلترهای صفحه محصولات ظاهر می‌شوند.</span>
</div>

@if (TempData["Ok"] is string ok)
{
    <div class="alert alert-success py-2">@ok</div>
}

<div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
    <form method="get" class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label small text-muted">دسته‌بندی</label>
            <select name="categoryId" class="form-select" onchange="this.form.submit()">
                @foreach (var o in ViewBag.CategoryOptions)
                {
                    <option value="@o.Id" selected="@(o.Id == (int)ViewBag.SelectedId)">@o.Label</option>
                }
            </select>
        </div>
        <noscript><div class="col-auto"><button class="btn btn-primary">نمایش</button></div></noscript>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
    <h6 class="fw-bold mb-3">افزودن ویژگی جدید</h6>
    <form asp-action="Create" method="post" class="row g-3 align-items-center">
        <input type="hidden" name="categoryId" value="@ViewBag.SelectedId" />
        <div class="col-md-4">
            <input name="name" class="form-control" placeholder="نام ویژگی (مثلاً: حافظه داخلی)" required />
        </div>
        <div class="col-md-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="showInFilter" value="true" checked id="sf" />
                <label class="form-check-label small" for="sf">نمایش در فیلترها</label>
            </div>
        </div>
        <div class="col-md-3">
            <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" name="isVariantOption" value="true" id="vo" />
                <label class="form-check-label small" for="vo">گزینه واریانت (قیمت/موجودی مستقل)</label>
            </div>
        </div>
        <div class="col-md-2">
            <button class="btn btn-primary w-100">افزودن</button>
        </div>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-4 p-4">
    @if (Model.Count == 0)
    {
        <p class="text-muted mb-0">برای این دسته هنوز ویژگی‌ای تعریف نشده — اولین ویژگی را اضافه کنید.</p>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>نام ویژگی</th>
                    <th>نمایش در فیلترها</th>
                    <th>گزینه واریانت</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="fw-bold">@a.Name</td>
                        <td>
                            <form asp-action="Toggle" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@a.Id" />
                                <input type="hidden" name="categoryId" value="@ViewBag.SelectedId" />
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input" type="checkbox" role="switch"
                                           checked="@a.ShowInFilter" onchange="this.form.submit()" />
                                </div>
                            </form>
                        </td>
                        <td>@(a.IsVariantOption ? "بله" : "خیر")</td>
                        <td class="text-end">
                            <form asp-action="Delete" method="post" class="d-inline"
                                  onsubmit="return confirm('این ویژگی حذف شود؟');">
                                <input type="hidden" name="id" value="@a.Id" />
                                <input type="hidden" name="categoryId" value="@ViewBag.SelectedId" />
                                <button class="btn btn-sm btn-outline-danger">حذف</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    <p class="small text-muted mb-0 mt-2">
        💡 مقادیر (مثلاً «۱۲۸ گیگابایت») از خود محصولات جمع‌آوری می‌شود — با تغییر دسته در صفحه محصولات،
        سایدبار فیلترها به‌صورت خودکار ساخته می‌شود. ویژگی‌های «گزینه واریانت» در ترکیب‌های رنگ/سایز با
        قیمت و موجودی مستقل استفاده می‌شوند.
    </p>
</div>
