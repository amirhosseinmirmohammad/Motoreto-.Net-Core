@model PagedResult<OrderListItemDto>
@{
    ViewData["Title"] = "سفارش‌ها";
    var status = ViewBag.Status as string;
    var q = ViewBag.Q as string;
    var statuses = ViewBag.Statuses as List<dynamic>;
    var page = Model.Page;
    var totalPages = Model.TotalPages;
}
<div class="toolbar">
    <form method="get" style="display:flex;gap:8px;flex-wrap:wrap;">
        <input type="text" name="q" value="@q" placeholder="شماره سفارش / نام / تلفن" style="width:220px" />
        <select name="status">
            <option value="">همه وضعیت‌ها</option>
            @if (statuses != null)
            {
                @foreach (var s in statuses)
                {
                    <option value="@s.Value" selected="@(status == (string)s.Value)">@s.Title</option>
                }
            }
        </select>
        <button class="btn btn-light">فیلتر</button>
    </form>
</div>

<div class="table-wrap">
    <table>
        <thead><tr><th>شماره</th><th>اقلام</th><th>مبلغ</th><th>تاریخ</th><th>وضعیت</th><th></th></tr></thead>
        <tbody>
            @foreach (var o in Model.Items)
            {
                <tr>
                    <td style="font-weight:700">@o.OrderNumber.ToFarsiDigits()</td>
                    <td>@o.ItemsCount.ToString().ToFarsiDigits() عدد</td>
                    <td>@o.Total.ToToman()</td>
                    <td class="text-muted2">@o.CreatedAt.ToPersianDateTime()</td>
                    <td><span class="badge badge-@o.StatusBadgeClass">@o.StatusTitle</span></td>
                    <td><a href="/admin/orders/details/@o.Id" class="btn btn-sm btn-light">جزئیات</a></td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Items.Count == 0)
    {
        <div class="empty">سفارشی یافت نشد.</div>
    }
</div>

@if (totalPages > 1)
{
    <div class="pager">
        @for (var i = 1; i <= totalPages; i++)
        {
            if (i == page)
            {
                <span class="current">@i.ToString().ToFarsiDigits()</span>
            }
            else
            {
                <a href="/admin/orders?page=@i&status=@status&q=@q">@i.ToString().ToFarsiDigits()</a>
            }
        }
    </div>
}
