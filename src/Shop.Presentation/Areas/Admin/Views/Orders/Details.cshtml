@model OrderDetailDto
@{
    ViewData["Title"] = "سفارش " + Model.OrderNumber;
    var statuses = ViewBag.Statuses as List<OrderStatus>;
}
<div class="two-col">
    <div>
        <div class="card">
            <strong>اقلام سفارش (@Model.Items.Count.ToString().ToFarsiDigits() قلم)</strong>
            <table class="mt">
                <thead><tr><th>محصول</th><th>قیمت</th><th>تعداد</th><th>جمع</th></tr></thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td style="white-space:normal">
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <img src="@item.Image" alt="" loading="lazy" />
                                    <span>@item.ProductName</span>
                                </div>
                            </td>
                            <td>@item.UnitPrice.ToToman()</td>
                            <td>@item.Quantity.ToString().ToFarsiDigits()</td>
                            <td>@item.LineTotal.ToToman()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="card mt">
            <strong>اطلاعات گیرنده</strong>
            <table class="mt">
                <tr><td class="text-muted2">گیرنده</td><td>@Model.ReceiverName</td></tr>
                <tr><td class="text-muted2">تماس</td><td>@Model.Phone.ToFarsiDigits()</td></tr>
                <tr><td class="text-muted2">آدرس</td><td style="white-space:normal">@Model.StateName، @Model.CityName، @Model.Address</td></tr>
                @if (!string.IsNullOrEmpty(Model.PostalCode))
                {
                    <tr><td class="text-muted2">کد پستی</td><td>@Model.PostalCode.ToFarsiDigits()</td></tr>
                }
                @if (!string.IsNullOrEmpty(Model.Note))
                {
                    <tr><td class="text-muted2">توضیح مشتری</td><td style="white-space:normal">@Model.Note</td></tr>
                }
                <tr><td class="text-muted2">ارسال / پرداخت</td><td>@Model.ShippingMethodTitle / @Model.PaymentMethodTitle</td></tr>
            </table>
        </div>
    </div>

    <div>
        <div class="card">
            <strong>خلاصه مالی</strong>
            <table class="mt">
                <tr><td class="text-muted2">جمع کالاها</td><td>@Model.Subtotal.ToToman()</td></tr>
                <tr><td class="text-muted2">تخفیف</td><td>@Model.DiscountAmount.ToToman()</td></tr>
                <tr><td class="text-muted2">ارسال</td><td>@(Model.ShippingCost == 0 ? "رایگان" : Model.ShippingCost.ToToman())</td></tr>
                <tr><td style="font-weight:800">کل</td><td style="font-weight:800">@Model.Total.ToToman()</td></tr>
                <tr><td class="text-muted2">ثبت</td><td class="text-muted2">@Model.CreatedAt.ToPersianDateTime()</td></tr>
                @if (Model.PaidAt is not null)
                {
                    <tr><td class="text-muted2">پرداخت</td><td class="text-muted2">@Model.PaidAt.Value.ToPersianDateTime()</td></tr>
                }
            </table>
        </div>

        <div class="card mt">
            <strong>تغییر وضعیت</strong>
            <p>وضعیت فعلی: <span class="badge badge-@Model.StatusBadgeClass">@Model.StatusTitle</span></p>
            <form method="post" action="/admin/orders/updatestatus/@Model.Id">
                @Html.AntiForgeryToken()
                <select name="status">
                    @if (statuses != null)
                    {
                        @foreach (var s in statuses)
                        {
                            <option value="@s">@OrderTitles.StatusTitle(s)</option>
                        }
                    }
                </select>
                <button class="btn mt" style="width:100%">ثبت وضعیت</button>
            </form>
            <div class="text-muted2 mt">لغو سفارش پرداخت‌شده، موجودی به‌صورت خودکار بازمی‌گردد.</div>
        </div>

        <a href="/admin/orders" class="btn btn-light mt" style="width:100%">بازگشت به لیست</a>
    </div>
</div>
