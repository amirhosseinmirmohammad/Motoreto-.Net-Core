{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=56432;Database=shop;Username=shop_user;Password=Shop!2026;Include Error Detail=true",
    "Redis": "localhost:56379"
  },
  "ObjectStorage": {
    "Endpoint": "localhost:8333",
    "AccessKey": "shop",
    "SecretKey": "shop12345",
    "Bucket": "shop",
    "UseSsl": false,
    "PublicBaseUrl": "http://localhost:8333"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithEnvironmentName" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/app-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Properties": {
      "Application": "shop"
    }
  }
}
