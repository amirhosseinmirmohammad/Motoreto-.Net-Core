@page "/panel/ads"
@layout UserLayout
@attribute [Authorize]
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav
@inject IEventPublisher Events

<h5 class="fw-bold mb-3">📢 آگهی‌ها و گفتگوهای من</h5>

@if (_loading)
{
    <div class="d-flex justify-content-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    @if (_msg is not null)
    {
        <div class="alert alert-success py-2">@_msg</div>
    }

    @* ---------- کارت‌های آمار ---------- *@
    <div class="row g-3 mb-3">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="fs-4 fw-bold text-primary">@_stats.TotalViews.ToString("N0").ToFarsiDigits()</div>
                <div class="small text-muted">بازدید کل</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="fs-4 fw-bold text-success">@_stats.ActiveCount.ToString("N0").ToFarsiDigits()</div>
                <div class="small text-muted">آگهی فعال</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="fs-4 fw-bold text-info">@_stats.TotalChats.ToString("N0").ToFarsiDigits()</div>
                <div class="small text-muted">پیام‌های گفتگو</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-3 text-center">
                <div class="fs-4 fw-bold text-warning">@_stats.Favorites.ToString("N0").ToFarsiDigits()</div>
                <div class="small text-muted">ذخیره‌شده</div>
            </div>
        </div>
    </div>

    @* ---------- نمودار بازدید ۱۴ روز اخیر ---------- *@
    @if (_chart14.Count > 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
            <h6 class="fw-bold mb-3">📊 بازدید ۱۴ روز اخیر</h6>
            <div class="d-flex align-items-end gap-1" style="height:110px">
                @foreach (var d in _chart14)
                {
                    var h = d.Max > 0 ? Math.Max(6, d.Count * 100 / d.Max) : 6;
                    <div class="flex-fill text-center" title="@d.Label: @d.Count.ToString("N0") بازدید">
                        <div class="bg-primary rounded-top mx-auto" style="height:@(h)px;width:70%;opacity:.85"></div>
                        <div class="small text-muted" style="font-size:.6rem">@d.Label</div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
        <h6 class="fw-bold mb-3">آگهی‌های من <NavLink href="/ads/post" class="btn btn-sm btn-primary float-end">+ آگهی جدید</NavLink></h6>
        @if (_myAds.Count == 0)
        {
            <p class="text-muted small mb-0">هنوز آگهی ثبت نکرده‌اید.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead><tr><th>عنوان</th><th>قیمت</th><th>وضعیت</th><th>بازدید</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var a in _myAds)
                        {
                            <tr>
                                <td class="fw-bold" style="max-width:220px">@a.Title
                                    @if (a.Featured)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">⬆️ نردبان</span>
                                    }
                                    @if (a.Urgent)
                                    {
                                        <span class="badge bg-danger ms-1">⚡ فوری</span>
                                    }
                                    @if (a.OwnerVerified)
                                    {
                                        <span class="badge bg-info text-dark ms-1" title="احراز هویت‌شده">✔</span>
                                    }
                                </td>
                                <td class="small">@(a.Price is null ? "توافقی" : a.Price == 0 ? "رایگان" : a.Price.Value.ToString("N0"))</td>
                                <td><span class="badge bg-@(a.Status == ClassifiedAdStatus.Approved ? "success" : a.Status == ClassifiedAdStatus.Pending ? "warning text-dark" : "secondary")">@StatusText(a.Status)</span></td>
                                <td class="small">@a.ViewCount.ToString("N0")</td>
                                <td class="text-end" style="white-space:nowrap">
                                    <NavLink href="@($"/ads/{a.Id}")" class="btn btn-sm btn-outline-secondary">نمایش</NavLink>
                                    <button class="btn btn-sm btn-outline-dark" disabled="@_busy" @onclick="() => ToggleSoldAsync(a.Id)">
                                        @(a.Status == ClassifiedAdStatus.Sold ? "فعال‌سازی" : "فروخته شد")
                                    </button>
                                    <NavLink href="@($"/panel/ads/chat/{a.Id}")" class="btn btn-sm btn-outline-primary">گفتگو</NavLink>
                                    @if (a.Status != ClassifiedAdStatus.Sold)
                                    {
                                        <NavLink href="@($"/panel/ads/edit/{a.Id}")" class="btn btn-sm btn-outline-secondary">ویرایش</NavLink>
                                    }
                                    @if (a.Status == ClassifiedAdStatus.Expired || (a.ExpiresAt is not null && a.ExpiresAt < DateTime.UtcNow.AddDays(7)))
                                    {
                                        <button class="btn btn-sm btn-outline-success" disabled="@_busy" @onclick="() => RenewAsync(a.Id)">تمدید ۳۰ روز</button>
                                    }
                                    @if (a.Status == ClassifiedAdStatus.Approved)
                                    {
                                        var p = _catPrices.GetValueOrDefault(a.CatId);
                                        <button class="btn btn-sm btn-outline-warning" disabled="@_busy" title="۷ روز بالای لیست" @onclick="() => PromoteAsync(a.Id, K.Bump)">⬆️ @p.Bump.ToString("N0")</button>
                                        <button class="btn btn-sm btn-outline-danger" disabled="@_busy" title="۷ روز برچسب فوری" @onclick="() => PromoteAsync(a.Id, K.Urgent)">⚡ @p.Urgent.ToString("N0")</button>
                                        <button class="btn btn-sm btn-outline-success" disabled="@_busy" title="فوری + نردبان همزمان" @onclick="() => PromoteAsync(a.Id, K.Combo)">⚡⬆️ @p.Combo.ToString("N0")</button>
                                    }
                                    <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="() => DeleteAsync(a.Id)">حذف</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
        <h6 class="fw-bold mb-3">جستجوهای ذخیره‌شده</h6>
        @if (_searches.Count == 0)
        {
            <p class="text-muted small mb-0">جستجویی ذخیره نکرده‌اید — از صفحه آگهی‌ها با دکمه «ذخیره جستجو».</p>
        }
        else
        {
            @foreach (var s in _searches)
            {
                <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                    <NavLink href="@SearchLink(s)" class="small text-decoration-none text-dark">
                        <i class="bi bi-search me-1"></i>@SearchLabel(s)
                    </NavLink>
                    <button class="btn btn-sm btn-outline-danger py-0" disabled="@_busy" @onclick="() => DeleteSearchAsync(s.Id)">حذف</button>
                </div>
            }
        }
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h6 class="fw-bold mb-3">❤️ آگهی‌های ذخیره‌شده</h6>
        @if (_favs.Count == 0)
        {
            <p class="text-muted small mb-0">آگهی ذخیره‌شده‌ای ندارید — از صفحه هر آگهی با دکمه «ذخیره آگهی».</p>
        }
        else
        {
            @foreach (var f in _favs)
            {
                <div class="d-flex justify-content-between align-items-center border-bottom py-2">
                    <NavLink href="@($"/ads/{f.AdId}")" class="small text-decoration-none text-dark">@f.Title</NavLink>
                    <button class="btn btn-sm btn-outline-danger py-0" disabled="@_busy" @onclick="() => UnfavAsync(f.Id)">حذف</button>
                </div>
            }
        }
    </div>
}

@code {
    private bool _loading = true, _busy;
    private string? _msg;
    private Guid _uid;
    private (int TotalViews, int ActiveCount, int TotalChats, int Favorites) _stats;
    private List<(string Label, int Count, int Max)> _chart14 = new();
    private List<AdRow> _myAds = new();
    private List<ChatRow> _myChats = new();
    private List<FavRow> _favs = new();
    private List<SearchRow> _searches = new();
    private Dictionary<int, CatPrices> _catPrices = new();
    private Dictionary<int, string> _catNames = new();

    private sealed record AdRow(long Id, string Title, long? Price, ClassifiedAdStatus Status, long ViewCount, int CatId, bool Featured, bool Urgent, DateTime? ExpiresAt, bool OwnerVerified);
    private sealed record ChatRow(long AdId, string Title, string LastText, DateTime LastAt);
    private sealed record FavRow(long Id, long AdId, string Title);
    private sealed record SearchRow(long Id, string? Q, string? CatName, string? CityName);
    private sealed record CatPrices(long Bump, long Urgent, long Combo);

    private static class K
    {
        public const string Bump = "bump";
        public const string Urgent = "urgent";
        public const string Combo = "combo";
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _uid = Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var g) ? g : Guid.Empty;

        _myAds = await Db.ClassifiedAds.AsNoTracking()
            .Where(a => a.UserId == _uid)
            .OrderByDescending(a => a.Id)
            .Select(a => new AdRow(a.Id, a.Title, a.Price, a.Status, a.ViewCount, a.ClassifiedCategoryId, a.IsFeatured, a.IsUrgent, a.ExpiresAt, a.User.IsIdentityVerified))
            .ToListAsync();

        _catPrices = await Db.ClassifiedCategories.AsNoTracking()
            .Select(c => new { c.Id, c.BumpPrice, c.UrgentPrice, c.ComboPrice })
            .ToDictionaryAsync(c => c.Id, c => new CatPrices(c.BumpPrice, c.UrgentPrice, c.ComboPrice));

        _catNames = await Db.ClassifiedCategories.AsNoTracking()
            .Select(c => new { c.Id, c.Name })
            .ToDictionaryAsync(c => c.Id, c => c.Name);

        var cityNames = await Db.Cities.AsNoTracking().Select(c => new { c.Id, c.Name }).ToDictionaryAsync(c => c.Id, c => c.Name);

        _favs = (await Db.ClassifiedFavorites.AsNoTracking()
                .Where(f => f.UserId == _uid)
                .OrderByDescending(f => f.Id)
                .Select(f => new { f.Id, f.AdId, AdTitle = f.Ad.Title })
                .ToListAsync())
            .Select(f => new FavRow(f.Id, f.AdId, f.AdTitle))
            .ToList();

        var searches = await Db.ClassifiedSavedSearches.AsNoTracking()
            .Where(s => s.UserId == _uid)
            .OrderByDescending(s => s.Id)
            .ToListAsync();
        _searches = searches.Select(s => new SearchRow(
            s.Id, s.Q,
            s.CatId is null ? null : _catNames.GetValueOrDefault(s.CatId.Value),
            s.CityId is null ? null : cityNames.GetValueOrDefault(s.CityId.Value))).ToList();
        _searchesRaw = searches.ToDictionary(s => s.Id, s => s.CatId);
        _searchesRawCity = searches.ToDictionary(s => s.Id, s => s.CityId);

        // ---------- آمار آگهی‌دهنده ----------
        var since = DateTime.UtcNow.AddDays(-13).Date;
        var viewsByDay = await Db.ClassifiedAdViewDailies.AsNoTracking()
            .Where(v => v.UserId == _uid && v.Date >= since)
            .GroupBy(v => v.Date)
            .Select(g => new { Date = g.Key, Count = g.Sum(x => x.Count) })
            .ToListAsync();

        var chart = new List<(string Label, int Count, int Max)>();
        for (var i = 13; i >= 0; i--)
        {
            var day = DateTime.UtcNow.Date.AddDays(-i);
            var cnt = viewsByDay.FirstOrDefault(v => v.Date == day)?.Count ?? 0;
            var pc = new System.Globalization.PersianCalendar();
            chart.Add(($"{pc.GetMonth(day):00}/{pc.GetDayOfMonth(day):00}".ToFarsiDigits(), cnt, 0));
        }
        var max = chart.Count > 0 ? chart.Max(c => c.Count) : 0;
        _chart14 = chart.Select(c => (c.Label, c.Count, max)).ToList();

        _stats.TotalViews = (int)_myAds.Sum(a => a.ViewCount);
        _stats.ActiveCount = _myAds.Count(a => a.Status == ClassifiedAdStatus.Approved);
        _stats.Favorites = await Db.ClassifiedFavorites.CountAsync(f => f.Ad.UserId == _uid);
        _stats.TotalChats = await Db.ClassifiedChatMessages.CountAsync(m => m.Ad.UserId == _uid);

        var chatAdIds = await Db.ClassifiedChatMessages
            .Where(m => m.UserId == _uid || m.Ad.UserId == _uid)
            .Select(m => m.AdId)
            .Distinct()
            .ToListAsync();

        foreach (var adId in chatAdIds)
        {
            var row = await Db.ClassifiedAds.AsNoTracking()
                .Where(a => a.Id == adId)
                .Select(a => new { a.Id, a.Title })
                .FirstOrDefaultAsync();
            if (row is null) continue;

            var last = await Db.ClassifiedChatMessages.AsNoTracking()
                .Where(m => m.AdId == adId)
                .OrderByDescending(m => m.Id)
                .Select(m => new { m.Text, m.CreatedAt })
                .FirstOrDefaultAsync();
            if (last is not null)
                _myChats.Add(new ChatRow(row.Id, row.Title, last.Text, last.CreatedAt));
        }

        _loading = false;
    }

    private string SearchLabel(SearchRow s) => (s.Q ?? "همه آگهی‌ها")
        + (s.CatName is null ? "" : " • " + s.CatName)
        + (s.CityName is null ? "" : " • " + s.CityName);

    private string SearchLink(SearchRow s)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(s.Q)) parts.Add("q=" + Uri.EscapeDataString(s.Q));
        if (_searchesRaw.TryGetValue(s.Id, out var catId) && catId is not null) parts.Add("cat=" + catId);
        if (_searchesRawCity.TryGetValue(s.Id, out var cityId) && cityId is not null) parts.Add("city=" + cityId);
        return "/ads" + (parts.Count == 0 ? "" : "?" + string.Join("&", parts));
    }

    private Dictionary<long, int?> _searchesRaw = new();
    private Dictionary<long, int?> _searchesRawCity = new();

    private async Task ToggleSoldAsync(long id)
    {
        _busy = true;
        var a = await Db.ClassifiedAds.FirstAsync(x => x.Id == id && x.UserId == _uid);
        a.Status = a.Status == ClassifiedAdStatus.Sold ? ClassifiedAdStatus.Approved : ClassifiedAdStatus.Sold;
        await Db.SaveChangesAsync();
        await OnInitializedAsync();
        _busy = false;
    }

    private async Task DeleteAsync(long id)
    {
        _busy = true;
        await Db.ClassifiedChatMessages.Where(m => m.AdId == id && m.Ad.UserId == _uid).ExecuteDeleteAsync();
        await Db.ClassifiedFavorites.Where(f => f.AdId == id).ExecuteDeleteAsync();
        await Db.ClassifiedAds.Where(a => a.Id == id && a.UserId == _uid).ExecuteDeleteAsync();
        _msg = "آگهی حذف شد ✓";
        await OnInitializedAsync();
        _busy = false;
    }

    private async Task RenewAsync(long id)
    {
        _busy = true;
        var a = await Db.ClassifiedAds.FirstAsync(x => x.Id == id && x.UserId == _uid);
        a.ExpiresAt = DateTime.UtcNow.AddDays(30);
        if (a.Status == ClassifiedAdStatus.Expired) a.Status = ClassifiedAdStatus.Approved;
        await Db.SaveChangesAsync();
        _msg = "آگهی ۳۰ روز دیگر تمدید شد ✓";
        await OnInitializedAsync();
        _busy = false;
    }

    /// <summary>خرید نردبان/فوری/کمبو از کیف پول (تعرفهٔ هر دسته متفاوت است).</summary>
    private async Task PromoteAsync(long id, string kind)
    {
        _busy = true;
        try
        {
            var a = await Db.ClassifiedAds.Include(x => x.Category).FirstAsync(x => x.Id == id && x.UserId == _uid);
            var price = kind switch
            {
                K.Bump => a.Category.BumpPrice,
                K.Urgent => a.Category.UrgentPrice,
                _ => a.Category.ComboPrice
            };

            var user = await Db.Users.FirstAsync(u => u.Id == _uid);
            if (user.WalletBalance < price)
            {
                _msg = $"موجودی کیف پول کافی نیست ({price:N0} تومان). ابتدا کیف پول را شارژ کنید.";
                return;
            }

            user.WalletBalance -= price;
            Db.WalletTransactions.Add(new WalletTransaction
            {
                UserId = _uid,
                Amount = price,
                Type = WalletTransactionType.ClassifiedAdPayment,
                BalanceAfter = user.WalletBalance,
                Description = kind switch
                {
                    K.Bump => "نردبان آگهی: " + a.Title,
                    K.Urgent => "فوری‌سازی آگهی: " + a.Title,
                    _ => "کمبو فوری+نردبان آگهی: " + a.Title
                },
                CreatedAt = DateTime.UtcNow
            });

            if (kind is K.Bump or K.Combo) { a.IsFeatured = true; a.BumpAt = DateTime.UtcNow; }
            if (kind is K.Urgent or K.Combo) { a.IsUrgent = true; a.UrgentAt = DateTime.UtcNow; }

            await Db.SaveChangesAsync();
            await Events.PublishNotificationAsync(new Application.Interfaces.NotificationEvent(
                _uid, "🚀 آگهی شما ارتقا یافت", a.Title, "bi-rocket-takeoff", $"/ads/{id}"));
            _msg = "ارتقای آگهی با موفقیت انجام شد ✓";
            await OnInitializedAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteSearchAsync(long id)
    {
        _busy = true;
        await Db.ClassifiedSavedSearches.Where(s => s.Id == id && s.UserId == _uid).ExecuteDeleteAsync();
        await OnInitializedAsync();
        _busy = false;
    }

    private async Task UnfavAsync(long id)
    {
        _busy = true;
        await Db.ClassifiedFavorites.Where(f => f.Id == id && f.UserId == _uid).ExecuteDeleteAsync();
        await OnInitializedAsync();
        _busy = false;
    }

    private static string StatusText(ClassifiedAdStatus s) => s switch
    {
        ClassifiedAdStatus.Approved => "منتشرشده",
        ClassifiedAdStatus.Pending => "در انتظار تأیید",
        ClassifiedAdStatus.Rejected => "ردشده",
        ClassifiedAdStatus.Sold => "فروخته‌شده",
        _ => "منقضی"
    };
}
