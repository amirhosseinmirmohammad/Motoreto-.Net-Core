@page "/panel/password"
@layout UserLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Identity
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthState

<h5 class="fw-bold mb-3">🔒 تغییر رمز عبور</h5>

@if (_ok)
{
    <div class="alert alert-success py-2">رمز عبور با موفقیت تغییر کرد ✓</div>
}
@if (_errors.Count > 0)
{
    <div class="alert alert-danger py-2">
        <ul class="mb-0 ps-3">
            @foreach (var e in _errors)
            {
                <li>@e</li>
            }
        </ul>
    </div>
}

<div class="card border-0 shadow-sm rounded-4 p-4" style="max-width:520px">
    <EditForm Model="_m" OnValidSubmit="SubmitAsync" class="row g-3">
        <DataAnnotationsValidator />

        <div class="col-12">
            <label class="form-label small text-muted">رمز عبور فعلی *</label>
            <InputText type="password" @bind-Value="_m.CurrentPassword" class="form-control" dir="ltr" />
            <ValidationMessage For="() => _m.CurrentPassword" class="text-danger small" />
        </div>
        <div class="col-12">
            <label class="form-label small text-muted">رمز عبور جدید *</label>
            <InputText type="password" @bind-Value="_m.NewPassword" class="form-control" dir="ltr" />
            <ValidationMessage For="() => _m.NewPassword" class="text-danger small" />
        </div>
        <div class="col-12">
            <label class="form-label small text-muted">تکرار رمز عبور جدید *</label>
            <InputText type="password" @bind-Value="_m.ConfirmPassword" class="form-control" dir="ltr" />
            <ValidationMessage For="() => _m.ConfirmPassword" class="text-danger small" />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary w-100" disabled="@_busy">
                @(_busy ? "در حال تغییر..." : "تغییر رمز عبور")
            </button>
        </div>
    </EditForm>
</div>

@code {
    private ChangePasswordViewModel _m = new();
    private List<string> _errors = new();
    private bool _busy, _ok;

    private async Task SubmitAsync()
    {
        _busy = true;
        _ok = false;
        _errors.Clear();

        try
        {
            var uid = await GetUserIdAsync();
            var user = await UserManager.FindByIdAsync(uid.ToString());

            if (user is null)
            {
                _errors.Add("کاربر یافت نشد.");
            }
            else
            {
                var result = await UserManager.ChangePasswordAsync(user, _m.CurrentPassword, _m.NewPassword);
                if (result.Succeeded)
                {
                    _ok = true;
                    _m = new ChangePasswordViewModel();
                }
                else
                {
                    _errors.AddRange(result.Errors.Select(e => e.Description));
                }
            }
        }
        catch (Exception ex)
        {
            _errors.Add("خطا: " + ex.Message);
        }

        _busy = false;
    }

    private async Task<Guid> GetUserIdAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var v = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(v, out var id) ? id : Guid.Empty;
    }
}
