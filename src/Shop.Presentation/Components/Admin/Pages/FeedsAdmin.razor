@page "/manage/feeds"
@layout AdminLayout
@attribute [Authorize]
@using Shop.Presentation.Services
@inject ApplicationDbContext Db
@inject FeedImportService Importer

<h4 class="fw-bold mb-1">🔌 فروشگاه‌های متصل (Feed)</h4>
<p class="text-muted small">مدل تروب: فروشگاه feed JSON می‌دهد (title, price_toman, stock, image_url, category, external_id) و سیستم خودکار import/همگام می‌کند.</p>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <h6 class="fw-bold mb-3">➕ اتصال فروشگاه جدید</h6>
    <div class="row g-3">
        <div class="col-md-3">
            <label class="form-label small text-muted">نام فروشگاه *</label>
            <input type="text" class="form-control" value="@_name" @oninput="e => _name = e.Value?.ToString()" />
        </div>
        <div class="col-md-3">
            <label class="form-label small text-muted">ایمیل تماس *</label>
            <input type="email" class="form-control" dir="ltr" value="@_email" @oninput="e => _email = e.Value?.ToString()" />
        </div>
        <div class="col-md-6">
            <label class="form-label small text-muted">آدرس Feed (JSON) *</label>
            <input type="text" class="form-control" dir="ltr" placeholder="https://shop.example/feed.json" value="@_url" @oninput="e => _url = e.Value?.ToString()" />
        </div>
        <div class="col-12">
            <button class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_name) || string.IsNullOrWhiteSpace(_url))" @onclick="AddAsync">
                اتصال فروشگاه
            </button>
        </div>
    </div>
</div>

@if (_editId is not null)
{
    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
        <h6 class="fw-bold mb-3">✏️ ویرایش فروشگاه متصل</h6>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small text-muted">نام فروشگاه</label>
                <input type="text" class="form-control" value="@_eName" @oninput="e => _eName = e.Value?.ToString()" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted">آدرس Feed</label>
                <input type="text" class="form-control" dir="ltr" value="@_eUrl" @oninput="e => _eUrl = e.Value?.ToString()" />
            </div>
            <div class="col-md-2">
                <label class="form-label small text-muted">فاصله Sync (دقیقه)</label>
                <input type="number" class="form-control" min="0" value="@_eInterval" @oninput="e => _eInterval = int.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
            </div>
            <div class="col-md-3 d-flex align-items-end gap-2">
                <button class="btn btn-primary" disabled="@_busy" @onclick="SaveEditAsync">ذخیره</button>
                <button class="btn btn-outline-secondary" @onclick="() => _editId = null">انصراف</button>
            </div>
        </div>
    </div>
}

@if (_loading)
{
    <div class="d-flex justify-content-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    @foreach (var f in _rows)
    {
        <div class="card border-0 shadow-sm rounded-4 p-3 mb-3">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <div class="fw-bold">
                        @f.ShopName
                        <span class="badge bg-@(f.Active ? "success" : "secondary") ms-1">@(f.Active ? "فعال" : "غیرفعال")</span>
                    </div>
                    <div class="small text-muted mt-1" dir="ltr">@f.FeedUrl</div>
                    <div class="small mt-1">
                        📦 @f.ProductCount.ToString("N0") کالا
                        • آخرین sync: @(f.LastSync?.ToString("yyyy/MM/dd HH:mm") ?? "—")
                        @if (f.Error is not null)
                        {
                            <span class="text-danger">• خطا: @f.Error</span>
                        }
                    </div>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditAsync(f.Id)">ویرایش</button>
                    <button class="btn btn-sm btn-success" disabled="@_busy" @onclick="() => SyncAsync(f.Id)">
                        <i class="bi bi-arrow-repeat"></i> همگام‌سازی
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => ToggleAsync(f.Id)">
                        @(f.Active ? "غیرفعال" : "فعال")
                    </button>
                    <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="() => DeleteAsync(f.Id)">حذف</button>
                </div>
            </div>
            @if (_msgFor.TryGetValue(f.Id, out var msg))
            {
                <div class="small text-success mt-2">@msg</div>
            }
        </div>
    }
}

@code {
    private bool _loading = true, _busy;
    private string _name = "", _email = "", _url = "";
    private List<FRow> _rows = new();
    private Dictionary<int, string> _msgFor = new();

    private sealed record FRow(int Id, string ShopName, string FeedUrl, int ProductCount, DateTime? LastSync, string? Error, bool Active);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _rows = await Db.ShopFeeds
            .AsNoTracking()
            .OrderByDescending(f => f.Id)
            .Select(f => new FRow(f.Id, f.ShopName, f.FeedUrl, f.ProductCount, f.LastSyncAt, f.LastSyncError, f.IsActive))
            .ToListAsync();
        _loading = false;
    }

    private async Task AddAsync()
    {
        _busy = true;
        Db.ShopFeeds.Add(new ShopFeed
        {
            ShopName = _name.Trim(),
            ContactEmail = _email.Trim(),
            FeedUrl = _url.Trim(),
            SyncIntervalMinutes = 360,
            IsActive = true
        });
        await Db.SaveChangesAsync();
        _name = _email = _url = "";
        await LoadAsync();
        _busy = false;
    }

    private async Task SyncAsync(int id)
    {
        _busy = true;
        var (ok, msg) = await Importer.SyncAsync(id);
        _msgFor[id] = (ok ? "✓ " : "✗ ") + msg;
        await LoadAsync();
        _busy = false;
    }

    private async Task ToggleAsync(int id)
    {
        _busy = true;
        var f = await Db.ShopFeeds.FirstAsync(x => x.Id == id);
        f.IsActive = !f.IsActive;
        await Db.SaveChangesAsync();
        await LoadAsync();
        _busy = false;
    }

    // ---- ویرایش/حذف ----
    private int? _editId;
    private string _eName = "", _eUrl = "";
    private int _eInterval;

    private async Task StartEditAsync(int id)
    {
        var f = await Db.ShopFeeds.AsNoTracking().FirstAsync(x => x.Id == id);
        _editId = id;
        _eName = f.ShopName;
        _eUrl = f.FeedUrl;
        _eInterval = f.SyncIntervalMinutes;
    }

    private async Task SaveEditAsync()
    {
        if (_editId is null) return;
        _busy = true;
        try
        {
            var f = await Db.ShopFeeds.FirstAsync(x => x.Id == _editId.Value);
            f.ShopName = _eName.Trim();
            f.FeedUrl = _eUrl.Trim();
            f.SyncIntervalMinutes = Math.Max(0, _eInterval);
            await Db.SaveChangesAsync();
            _editId = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(int id)
    {
        _busy = true;
        try
        {
            // کالاهای import‌شده این فید غیرفعال و قطع نسبت می‌شوند (سابقه سفارش حفظ می‌شود)
            await Db.Products.Where(p => p.SourceFeedId == id).ExecuteUpdateAsync(s => s.SetProperty(p => p.SourceFeedId, (int?)null).SetProperty(p => p.IsActive, false));
            await Db.ShopFeeds.Where(f => f.Id == id).ExecuteDeleteAsync();
            if (_editId == id) _editId = null;
            await LoadAsync();
        }
        finally
        {
            _busy = false;
        }
    }
}
