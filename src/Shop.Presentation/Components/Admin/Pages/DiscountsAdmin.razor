@page "/manage/discounts"
@layout AdminLayout
@attribute [Authorize]
@inject ApplicationDbContext Db

    <h4 class="fw-bold mb-1">🎟️ کدهای تخفیف</h4>

    <div class="d-flex gap-2 mb-3">
        <select class="form-select" style="max-width:220px" value="@_sort" @onchange="SortChanged">
            <option value="new">جدیدترین</option>
            <option value="expire">نزدیک‌ترین انقضا</option>
            <option value="used">پراستفاده‌ترین</option>
        </select>
    </div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="fw-bold mb-3">کد جدید</h6>
            @if (_err is not null)
            {
                <div class="alert alert-danger py-2 small">@_err</div>
            }
            <div class="mb-2">
                <label class="form-label small text-muted">کد (لاتین) *</label>
                <input type="text" class="form-control" dir="ltr" value="@_code" @oninput="e => _code = e.Value?.ToString()" />
            </div>
            <div class="mb-2">
                <label class="form-label small text-muted">عنوان *</label>
                <input type="text" class="form-control" value="@_title" @oninput="e => _title = e.Value?.ToString()" />
            </div>
            <div class="row g-2 mb-2">
                <div class="col-6">
                    <label class="form-label small text-muted">درصد *</label>
                    <input type="number" class="form-control" min="1" max="100" value="@_percent" @oninput="e => _percent = byte.TryParse(e.Value?.ToString(), out var v) ? v : (byte)10" />
                </div>
                <div class="col-6">
                    <label class="form-label small text-muted">سقف استفاده</label>
                    <input type="number" class="form-control" min="0" placeholder="0 = بی‌نهایت" value="@_limit" @oninput="e => _limit = int.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                </div>
            </div>
            <div class="row g-2 mb-3">
                <div class="col-6">
                    <label class="form-label small text-muted">حداقل سفارش (تومان)</label>
                    <input type="number" class="form-control" min="0" value="@_min" @oninput="e => _min = long.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                </div>
                <div class="col-6">
                    <label class="form-label small text-muted">انقضا</label>
                    <input type="date" class="form-control" value="@_expire" @oninput="e => _expire = e.Value?.ToString()" />
                </div>
            </div>
            <button class="btn btn-primary w-100" disabled="@(_busy || string.IsNullOrWhiteSpace(_code))" @onclick="AddAsync">
                @(_busy ? "..." : "ایجاد کد")
            </button>
        </div>

        @if (_editId is not null)
        {
            <div class="card border-0 shadow-sm rounded-4 p-4 mt-3">
                <h6 class="fw-bold mb-3">✏️ ویرایش کد @(_editCode)</h6>
                <div class="mb-2">
                    <label class="form-label small text-muted">عنوان</label>
                    <input type="text" class="form-control" value="@_eTitle" @oninput="e => _eTitle = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted">درصد</label>
                        <input type="number" class="form-control" min="1" max="100" value="@_ePercent" @oninput="e => _ePercent = byte.TryParse(e.Value?.ToString(), out var v) ? v : (byte)10" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">سقف مبلغ تخفیف (۰ = بی‌نهایت)</label>
                        <input type="number" class="form-control" min="0" value="@_eMax" @oninput="e => _eMax = long.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                    </div>
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-6">
                        <label class="form-label small text-muted">حداقل سفارش (تومان)</label>
                        <input type="number" class="form-control" min="0" value="@_eMin" @oninput="e => _eMin = long.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small text-muted">سقف استفاده (۰ = بی‌نهایت)</label>
                        <input type="number" class="form-control" min="0" value="@_eLimit" @oninput="e => _eLimit = int.TryParse(e.Value?.ToString(), out var v) ? v : 0" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label small text-muted">انقضا</label>
                    <input type="date" class="form-control" value="@_eExpire" @oninput="e => _eExpire = e.Value?.ToString() ?? string.Empty" />
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-primary flex-fill" disabled="@_busy" @onclick="SaveEditAsync">ذخیره</button>
                    <button class="btn btn-outline-secondary" @onclick="() => _editId = null">انصراف</button>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>کد</th>
                            <th>درصد</th>
                            <th>استفاده</th>
                            <th>انقضا</th>
                            <th>وضعیت</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _rows)
                        {
                            <tr>
                                <td class="fw-bold" dir="ltr">@d.Code</td>
                                <td>@d.Percent٪ <span class="text-muted small">@(d.MaxAmount is null ? "" : $"سقف {d.MaxAmount:N0}")</span></td>
                                <td>@d.Used.ToString("N0") @(d.Limit is null ? "" : $"/ {d.Limit:N0}")</td>
                                <td class="small">@(d.Expire is null ? "—" : Fa(d.Expire.Value))</td>
                                <td><span class="badge bg-@(d.Active ? "success" : "secondary")">@(d.Active ? "فعال" : "غیرفعال")</span></td>
                                <td class="text-end" style="white-space:nowrap">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => StartEditAsync(d.Id)">ویرایش</button>
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => ToggleAsync(d.Id)">
                                        @(d.Active ? "غیرفعال" : "فعال")
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="() => DeleteAsync(d.Id)">حذف</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_rows.Count == 0)
            {
                <p class="text-muted text-center mb-0">کدی ثبت نشده است.</p>
            }
        </div>
    </div>
</div>

    <Pager Page="_page" TotalPages="_totalPages" PageChanged="GoPage" />
}

@code {
    private string _code = "", _title = "", _expire = "";
    private byte _percent = 10;
    private int _limit;
    private long _min;
    private bool _busy;
    private string? _err;
    private string _sort = "new";
    private int _page = 1, _totalPages = 1;

    private async Task SortChanged(ChangeEventArgs e)
    {
        _sort = e.Value?.ToString() ?? "new";
        await LoadAsync();
    }
    private List<DRow> _rows = new();

    private async Task GoPage(int p)
    {
        _page = p;
        await LoadAsync();
    }

    private sealed record DRow(int Id, string Code, byte Percent, long? MaxAmount, int Used, int? Limit, DateTime? Expire, bool Active);

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var query = Db.Discounts.AsNoTracking();

        query = _sort switch
        {
            "expire" => query.OrderBy(d => d.ExpireAt ?? DateTime.MaxValue),
            "used" => query.OrderByDescending(d => d.UsedCount),
            _ => query.OrderByDescending(d => d.Id)
        };

        _rows = await query
            .Skip((_page - 1) * 20)
            .Take(20)
            .Select(d => new DRow(d.Id, d.Code, d.Percent, d.MaxAmount, d.UsedCount, d.UsageLimit, d.ExpireAt, d.IsActive))
            .ToListAsync();

        var total = await Db.Discounts.CountAsync();
        _totalPages = Math.Max(1, (int)Math.Ceiling(total / 20.0));
        if (_page > _totalPages) _page = _totalPages;
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_code)) return;
        _busy = true; _err = null;

        try
        {
            var dup = await Db.Discounts.AnyAsync(d => d.Code == _code.Trim().ToUpper());
            if (dup)
            {
                _err = "این کد قبلاً ثبت شده است.";
                _busy = false;
                return;
            }

            Db.Discounts.Add(new Discount
            {
                Code = _code.Trim().ToUpper(),
                Title = string.IsNullOrWhiteSpace(_title) ? _code.Trim() : _title.Trim(),
                Percent = Math.Clamp(_percent, (byte)1, (byte)100),
                MaxAmount = null,
                MinOrderAmount = _min,
                UsageLimit = _limit > 0 ? _limit : null,
                ExpireAt = DateTime.TryParse(_expire, out var dt) ? dt : null,
                IsActive = true
            });
            await Db.SaveChangesAsync();

            _code = ""; _title = ""; _expire = ""; _limit = 0; _min = 0;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _err = "خطا: " + ex.Message;
        }

        _busy = false;
    }

    private async Task ToggleAsync(int id)
    {
        _busy = true;
        var d = await Db.Discounts.FirstAsync(x => x.Id == id);
        d.IsActive = !d.IsActive;
        await Db.SaveChangesAsync();
        await LoadAsync();
        _busy = false;
    }

    // ---- ویرایش/حذف ----
    private int? _editId;
    private string _editCode = "";
    private string _eTitle = "", _eExpire = "";
    private byte _ePercent = 10;
    private long _eMax, _eMin;
    private int _eLimit;

    private async Task StartEditAsync(int id)
    {
        _err = null;
        var d = await Db.Discounts.AsNoTracking().FirstAsync(x => x.Id == id);
        _editId = id;
        _editCode = d.Code;
        _eTitle = d.Title;
        _ePercent = d.Percent;
        _eMax = d.MaxAmount ?? 0;
        _eMin = d.MinOrderAmount;
        _eLimit = d.UsageLimit ?? 0;
        _eExpire = d.ExpireAt?.ToString("yyyy-MM-dd") ?? "";
    }

    private async Task SaveEditAsync()
    {
        if (_editId is null) return;
        _busy = true;
        _err = null;
        try
        {
            var d = await Db.Discounts.FirstAsync(x => x.Id == _editId.Value);
            d.Title = string.IsNullOrWhiteSpace(_eTitle) ? d.Code : _eTitle.Trim();
            d.Percent = Math.Clamp(_ePercent, (byte)1, (byte)100);
            d.MaxAmount = _eMax > 0 ? _eMax : null;
            d.MinOrderAmount = _eMin;
            d.UsageLimit = _eLimit > 0 ? _eLimit : null;
            d.ExpireAt = DateTime.TryParse(_eExpire, out var dt) ? dt : null;
            await Db.SaveChangesAsync();
            _editId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _err = "خطا: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(int id)
    {
        _busy = true;
        _err = null;
        try
        {
            await Db.Discounts.Where(x => x.Id == id).ExecuteDeleteAsync();
            if (_editId == id) _editId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _err = "حذف ناموفق: " + ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static string Fa(DateTime d) => d.ToPersianDate();
}
