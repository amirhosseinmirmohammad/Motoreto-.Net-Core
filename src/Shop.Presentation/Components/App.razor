            <div class="splash-tagline">هر آنچه نیاز دارید، با بهترین قیمت</div>
            <div class="splash-loader">
                <div class="splash-dot"></div><div class="splash-dot"></div><div class="splash-dot"></div>
            </div>
        </div>
    </div>

    <Routes @rendermode="InteractiveServer" />
    <script src="lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="js/farsi-digits.js?v=2"></script>
    <script src="js/site.js?v=10"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
