<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#ef4056" />
    <base href="/" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/images/icons/icon-192.png" type="image/png" />
    <link rel="stylesheet" href="lib/bootstrap/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="lib/icons/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="css/site.css?v=14" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    @* ---------- PWA Splash Screen (مثل اسنپ) ---------- *@
    <div id="pwaSplash" class="pwa-splash">
        <div class="splash-content">
            <div class="splash-logo-ring"></div>
