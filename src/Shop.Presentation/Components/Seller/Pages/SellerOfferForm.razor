@page "/seller/offer"
@layout SellerLayout
@attribute [Authorize]
@inject ISellerService Sellers
@inject ApplicationDbContext Db
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<h5 class="fw-bold mb-1">🏷️ ثبت آفر جدید</h5>
<p class="text-muted small">قیمت و موجودی خود را برای یکی از کالاهای فروشگاه تعیین کنید. ارزان‌ترین آفر، در صفحه کالا نمایش داده می‌شود.</p>

@if (_error is not null)
{
    <div class="alert alert-danger py-2">@_error</div>
}

<div class="card border-0 shadow-sm rounded-4 p-4" style="max-width:620px">
    <EditForm Model="_in" OnValidSubmit="SubmitAsync" class="row g-3">
        <DataAnnotationsValidator />

        <div class="col-12">
            <label class="form-label small text-muted">کالا *</label>
            <SearchableSelect Options="_products.Select(p => new SearchableSelect.Opt(p.Id.ToString(), p.Name)).ToList()"
                              Value="_in.ProductId.ToString()"
                              ValueChanged="v => _in.ProductId = long.TryParse(v, out var l) ? l : 0"
                              Placeholder="جستجوی کالا..." />
            <ValidationMessage For="() => _in.ProductId" class="text-danger small" />
        </div>
        <div class="col-md-6">
            <label class="form-label small text-muted">قیمت (تومان) *</label>
            <InputNumber @bind-Value="_in.Price" class="form-control" />
            <ValidationMessage For="() => _in.Price" class="text-danger small" />
        </div>
        <div class="col-md-6">
            <label class="form-label small text-muted">درصد تخفیف (۰ تا ۹۰)</label>
            <input type="number" class="form-control" min="0" max="90" value="@_in.DiscountPercent"
                   @oninput="e => _in.DiscountPercent = byte.TryParse(e.Value?.ToString(), out var v) ? v : (byte)0" />
        </div>
        <div class="col-md-6">
            <label class="form-label small text-muted">موجودی *</label>
            <InputNumber @bind-Value="_in.Stock" class="form-control" />
            <ValidationMessage For="() => _in.Stock" class="text-danger small" />
        </div>
        <div class="col-md-6">
            <label class="form-label small text-muted">زمان ارسال (روز)</label>
            <InputNumber @bind-Value="_in.DeliveryDays" class="form-control" />
        </div>
        <div class="col-12">
            <label class="form-label small text-muted">گارانتی</label>
            <InputText @bind-Value="_in.Warranty" class="form-control" placeholder="مثلاً: ۱۸ ماه گارانتی شرکت" />
        </div>

        <div class="col-12">
            <button type="submit" class="btn btn-primary w-100 py-2" disabled="@_busy">
                @(_busy ? "در حال ثبت..." : "ثبت آفر")
            </button>
        </div>
    </EditForm>
</div>

@code {
    private SellerOfferInput _in = new();
    private List<ProdRow> _products = new();
    private bool _busy;
    private string? _error;

    private sealed record ProdRow(long Id, string Name);

    protected override async Task OnInitializedAsync()
    {
        var uid = await GetUserIdAsync();
        var seller = await Sellers.GetByUserAsync(uid);

        var catIds = seller is null
            ? new List<int>()
            : await Db.SellerCategories
                .AsNoTracking()
                .Where(sc => sc.SellerId == seller.Id)
                .Select(sc => sc.CategoryId)
                .ToListAsync();

        // فروشنده فقط کالاهای دسته‌های فعالیت خودش را می‌بیند
        var query = Db.Products.AsNoTracking().Where(p => p.IsActive);

        if (catIds.Count > 0)
            query = query.Where(p => catIds.Contains(p.CategoryId)
                || Db.ProductCategories.Any(pc => pc.ProductId == p.Id && catIds.Contains(pc.CategoryId)));

        _products = await query
            .OrderBy(p => p.Name)
            .Take(300)
            .Select(p => new ProdRow(p.Id, p.Name))
            .ToListAsync();
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;

        var uid = await GetUserIdAsync();
        var (ok, msg) = await Sellers.SaveOfferAsync(uid, _in);

        if (ok)
        {
            Nav.NavigateTo("/seller");
        }
        else
        {
            _error = msg;
            _busy = false;
        }
    }

    private async Task<Guid> GetUserIdAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var v = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        return Guid.TryParse(v, out var id) ? id : Guid.Empty;
    }
}
