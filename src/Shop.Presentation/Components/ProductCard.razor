<a href="/p/@Product.Slug" class="product-card text-decoration-none text-dark d-block bg-white rounded-3 p-2 h-100">
    <div class="position-relative">
        <img src="@Product.Image" class="w-100 rounded-3" style="aspect-ratio:1;object-fit:cover" alt="@Product.Name" loading="lazy" />
        @if (Product.DiscountPercent > 0)
        {
            <span class="position-absolute top-0 start-0 badge bg-danger">@Product.DiscountPercent٪</span>
        }
    </div>
    <div class="small fw-bold mt-2 text-truncate" title="@Product.Name">@Product.Name</div>
    <div class="text-muted text-truncate" style="font-size:.7rem">@Product.EnglishName</div>
    @if (!string.IsNullOrEmpty(Product.BrandName))
    {
        <div class="text-muted text-truncate" style="font-size:.66rem"><i class="bi bi-bookmark-star me-1"></i>@Product.BrandName</div>
    }
    <div class="d-flex align-items-center gap-1 mt-1" style="font-size:.72rem">
        <i class="bi bi-star-fill text-warning"></i>
        <span>@Product.AverageRating.ToString("0.0")</span>
        <span class="text-muted">(@Product.CommentCount)</span>
    </div>
    @if (Product.Stock > 0)
    {
        <div class="d-flex justify-content-between align-items-end mt-1">
            <div>
                @if (Product.DiscountPercent > 0)
                {
                    <del class="text-muted d-block" style="font-size:.68rem">@Product.UnitPrice.ToToman()</del>
                }
                <strong class="text-danger">@Product.FinalPrice.ToToman()</strong>
            </div>
            @if (Product.OfferCount > 0)
            {
                <span class="badge bg-light text-dark border" style="font-size:.6rem">@Product.OfferCount فروشنده</span>
            }
        </div>
    }
    else
    {
        <div class="text-muted small mt-2">ناموجود</div>
    }
</a>

@code {
    [Parameter, EditorRequired] public ProductCardDto Product { get; set; } = default!;
}
