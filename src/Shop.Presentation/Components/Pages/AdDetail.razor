@page "/ads/{Id:long}"
@inject ApplicationDbContext Db
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject IEventPublisher Events
@using System.Text.Json

@if (_ad is null)
{
    @if (_loaded)
    {
        <div class="alert alert-warning text-center my-5">آگهی موردنظر در دسترس نیست یا حذف شده است.</div>
    }
}
else
{
    <nav aria-label="breadcrumb" class="pt-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><NavLink href="/ads">آگهی‌ها</NavLink></li>
            <li class="breadcrumb-item active">@_ad.CategoryName</li>
        </ol>
    </nav>

    <div class="row g-4 pb-4">
        <div class="col-lg-7">
            <img src="@(_active ?? "/images/products/real/1.webp")" class="img-fluid rounded-4 shadow-sm w-100" style="max-height:420px;object-fit:cover" alt="@_ad.Title" />
            @if (_gallery.Count > 0)
            {
                <div class="d-flex gap-2 mt-2">
                    <img src="@_active" class="rounded-3 @(1 == 1 ? "border border-2 border-primary" : "")" style="width:72px;height:56px;object-fit:cover;cursor:pointer" @onclick="() => SetActive(null)" />
                    @foreach (var g in _gallery)
                    {
                        var img = g;
                        <img src="@img" class="rounded-3" style="width:72px;height:56px;object-fit:cover;cursor:pointer" @onclick="() => SetActive(img)" />
                    }
                </div>
            }
            <div class="card border-0 shadow-sm rounded-4 p-4 mt-3">
                <h4 class="fw-bold">@_ad.Title</h4>
                <p class="text-muted" style="white-space:pre-line">@_ad.Description</p>
            </div>

            @if (_attrs.Count > 0)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 mt-3">
                    <h6 class="fw-bold mb-3">مشخصات</h6>
                    <table class="table table-sm mb-0">
                        <tbody>
                            @foreach (var (name, value) in _attrs)
                            {
                                <tr>
                                    <td class="text-muted" style="width:40%">@name</td>
                                    <td class="fw-bold">@(value == "true" ? "دارد ✓" : value == "false" ? "ندارد" : value)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top:90px">
                <div class="fs-4 fw-bold text-success">
                    @(_ad.Price is null ? "قیمت توافقی" : _ad.Price == 0 ? "رایگان" : _ad.Price.Value.ToString("N0") + " تومان")
                </div>
                <hr />
                <div class="small text-muted">
                    <div class="mb-1"><i class="bi bi-tag"></i> دسته: <b>@_ad.CategoryName</b></div>
                    <div class="mb-1"><i class="bi bi-geo-alt"></i> شهر: <b>@_ad.CityName</b>@(_ad.Neighborhood is null ? "" : " — " + _ad.Neighborhood)</div>
                    @if (_ad.Lat is not null && _ad.Lng is not null)
                    {
                        <div class="mb-2">
                            <span class="small text-muted d-block mb-1"><i class="bi bi-signpost-2"></i> مسیریابی:</span>
                            <div class="d-flex gap-1 flex-wrap">
                                <a class="btn btn-sm btn-outline-primary rounded-pill" target="_blank"
                                   href="@($"https://www.google.com/maps/dir/?api=1&destination={_ad.Lat},{_ad.Lng}")">
                                    <i class="bi bi-google"></i> گوگل‌مپ
                                </a>
                                <a class="btn btn-sm btn-outline-success rounded-pill" target="_blank"
                                   href="@($"https://waze.com/ul?ll={_ad.Lat},{_ad.Lng}&navigate=yes")">
                                    <i class="bi bi-navigation"></i> ویز
                                </a>
                                <a class="btn btn-sm btn-outline-info rounded-pill" target="_blank"
                                   href="@($"https://neshan.org/maps/@{_ad.Lat},{_ad.Lng},15z")">
                                    نشان
                                </a>
                                <a class="btn btn-sm btn-outline-secondary rounded-pill" target="_blank"
                                   href="@($"https://balad.ir/location?latitude={_ad.Lat}&longitude={_ad.Lng}&zoom=15")">
                                    بلد
                                </a>
                            </div>
                        </div>
                    }
                    else if (_authed)
                    {
                        <a class="btn btn-sm btn-outline-secondary rounded-pill mb-2" target="_blank"
                           href="@($"https://www.google.com/maps/search/?api=1&query={Uri.EscapeDataString(_ad.CityName + " " + (_ad.Neighborhood ?? ""))}")">
                            <i class="bi bi-map"></i> جستجوی محله روی نقشه
                        </a>
                    }
                    <div class="mb-1"><i class="bi bi-clock"></i> ثبت: <b>@_ad.Date.ToPersianDateTime()</b></div>
                    <div><i class="bi bi-eye"></i> بازدید: <b>@_ad.ViewCount.ToString("N0").ToFarsiDigits()</b></div>
                </div>
                <hr />
                @if (_authed)
                {
                    <button class="btn btn-sm btn-outline-danger w-100 mb-2" disabled="@_favBusy" @onclick="ToggleFavAsync">
                        @(_favSaved ? "❤️ ذخیره شد — حذف از ذخیره‌ها" : "🤍 ذخیره آگهی")
                    </button>
                }
                @if (!_authed)
                {
                    @if (_needLogin)
                    {
                        <div class="alert alert-warning py-2 small mb-2">
                            برای مشاهده شماره تماس باید وارد حساب کاربری شوید.
                            <a href="@($"/account/login?returnUrl=/ads/{Id}")" class="d-block mt-1">ورود | ثبت‌نام</a>
                        </div>
                    }
                    <button class="btn btn-primary w-100" @onclick="TogglePhoneAsync">
                        <i class="bi bi-telephone"></i> نمایش شماره تماس
                    </button>
                }
                else
                {
                    <div class="text-center py-2 rounded-3 bg-light">
                        <span class="small text-muted d-block">شماره تماس آگهی‌دهنده — برای تماس کلیک کنید</span>
                        <a href="tel:@_ad.Phone" class="fw-bold fs-5 d-block" dir="ltr">@_ad.Phone</a>
                    </div>
                    @if (_restWarning)
                    {
                        <div class="alert alert-info py-2 small mt-2 mb-0">
                            ⏰ ساعات استراحت آگهی‌دهنده ممکن است باشد — ترجیحاً <b>پیام بدهید</b> یا از <b>گفتگو</b> استفاده کنید.
                        </div>
                    }
                }
                @if (_ad.Status == ClassifiedAdStatus.Sold)
                {
                    <div class="alert alert-secondary py-2 mt-2 mb-0 text-center small">این آگهی فروخته/مسترد شده است</div>
                }

                <div class="text-center mt-2">
                    @if (_reportSent)
                    {
                        <span class="small text-success">گزارش شما ثبت شد و بررسی می‌شود ✓</span>
                    }
                    else if (_reportOpen)
                    {
                        <textarea class="form-control form-control-sm" rows="2" placeholder="دلیل گزارش تخلف..."
                                  value="@_reportText" @oninput="e => _reportText = e.Value?.ToString() ?? string.Empty"></textarea>
                        @if (_reportErr is not null)
                        {
                            <div class="text-danger small mt-1">@_reportErr</div>
                        }
                        <button class="btn btn-sm btn-danger mt-1" disabled="@_reportBusy" @onclick="SendReportAsync">ارسال گزارش</button>
                    }
                    else
                    {
                        <button class="btn btn-link text-danger small p-0 mt-2" @onclick="() => _reportOpen = true">⚠️ گزارش تخلف این آگهی</button>
                    }
                </div>

                @if (_canChat)
                {
                    <hr />
                    @if (_chatSent)
                    {
                        <div class="alert alert-success py-2 small mb-0">پیام شما ارسال شد ✓ <NavLink href="@($"/panel/ads/chat/{Id}")">مشاهده گفتگو</NavLink></div>
                    }
                    else
                    {
                        <label class="form-label small text-muted">💬 پیام به آگهی‌دهنده</label>
                        <textarea class="form-control" rows="2" value="@_chatText" @oninput="e => _chatText = e.Value?.ToString() ?? string.Empty"></textarea>
                        @if (_chatErr is not null)
                        {
                            <div class="text-danger small mt-1">@_chatErr</div>
                        }
                        <button class="btn btn-outline-primary w-100 mt-2" disabled="@(_chatBusy || string.IsNullOrWhiteSpace(_chatText))" @onclick="SendChatAsync">ارسال پیام</button>
                    }
                }
                else if (_isOwnerViewing)
                {
                    <NavLink href="@($"/panel/ads/chat/{Id}")" class="btn btn-outline-primary w-100 mt-3">💬 گفتگوی این آگهی</NavLink>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public long Id { get; set; }

    private bool _loaded, _showPhone, _needLogin, _restWarning;
    private bool _authed, _favSaved, _favBusy;
    private bool _canChat, _isOwnerViewing, _chatSent, _chatBusy;
    private string _chatText = "";
    private string? _chatErr;
    private AdVm? _ad;
    private List<(string Name, string Value)> _attrs = new();

    private async Task TogglePhoneAsync()
    {
        if (!_authed) { _needLogin = true; return; }

        if (!_showPhone)
        {
            // ساعات استراحت: ۲۳ تا ۸ صبح به وقت ایران
            var iran = Shop.Shared.PersianDateHelper.ToIranTime(DateTime.UtcNow);
            _restWarning = iran.Hour >= 23 || iran.Hour < 8;
        }
        _showPhone = true;
        await Task.CompletedTask;
    }

    private sealed record AdVm(long Id, string Title, string? Description, long? Price, string Phone, string? MainImage,
        string CityName, string? Neighborhood, double? Lat, double? Lng, string CategoryName, DateTime Date, long ViewCount, ClassifiedAdStatus Status, string? AttrJson, string? ImagesJson);

    private string? _active;
    private List<string> _gallery = new();
    private bool _reportOpen, _reportSent, _reportBusy;
    private string _reportText = "";
    private string? _reportErr;

    private async Task SendReportAsync()
    {
        if (string.IsNullOrWhiteSpace(_reportText)) { _reportErr = "دلیل گزارش را بنویسید."; return; }
        _reportBusy = true;
        try
        {
            Db.SiteMessages.Add(new SiteMessage
            {
                FullName = "گزارش تخلف آگهی #" + Id,
                Email = "-",
                Subject = "گزارش تخلف آگهی #" + Id,
                Body = _reportText.Trim() + "\n---\nآگهی: " + _ad?.Title + " | لینک: /ads/" + Id,
                IsRead = false,
                CreatedAt = DateTime.UtcNow
            });
            await Db.SaveChangesAsync();
            _reportSent = true;
            _reportOpen = false;
        }
        catch (Exception ex)
        {
            _reportErr = "خطا: " + ex.Message;
        }
        finally
        {
            _reportBusy = false;
        }
    }

    private void SetActive(string? img) => _active = img ?? _ad?.MainImage;

    protected override async Task OnInitializedAsync()
    {
        var a = await Db.ClassifiedAds.AsNoTracking()
            .Where(x => x.Id == Id && (x.Status == ClassifiedAdStatus.Approved || x.Status == ClassifiedAdStatus.Sold))
            .Select(x => new AdVm(x.Id, x.Title, x.Description, x.Price, x.Phone, x.MainImage,
                x.City.Name, x.Neighborhood, x.Latitude, x.Longitude, x.Category.Name, x.CreatedAt, x.ViewCount, x.Status, x.AttributesJson, x.ImagesJson))
            .FirstOrDefaultAsync();

        if (a is not null)
        {
            _ad = a;
            _attrs = ParseAttrs(a.AttrJson);
            _active = a.MainImage;
            _gallery = (a.ImagesJson ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();
            await Db.ClassifiedAds.Where(x => x.Id == Id).ExecuteUpdateAsync(s => s.SetProperty(x => x.ViewCount, x => x.ViewCount + 1));

            // فرم پیام: فقط کاربر واردشده و غیرِ آگهی‌دهنده
            var auth = await AuthState.GetAuthenticationStateAsync();
            if (auth.User.Identity?.IsAuthenticated == true
                && Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var uid))
            {
                _authed = true;
                _isOwnerViewing = await Db.ClassifiedAds.AnyAsync(x => x.Id == Id && x.UserId == uid);
                _canChat = !_isOwnerViewing;
                _favSaved = await Db.ClassifiedFavorites.AnyAsync(f => f.UserId == uid && f.AdId == Id);
                _myUid = uid;
            }
        }
        _loaded = true;
    }

    private Guid _myUid;

    private static readonly object ChatLock = new();
    private static readonly Dictionary<Guid, DateTime> _lastSent = new();

    private async Task ToggleFavAsync()
    {
        _favBusy = true;
        try
        {
            if (_favSaved)
            {
                await Db.ClassifiedFavorites.Where(f => f.UserId == _myUid && f.AdId == Id).ExecuteDeleteAsync();
                _favSaved = false;
            }
            else
            {
                if (!await Db.ClassifiedFavorites.AnyAsync(f => f.UserId == _myUid && f.AdId == Id))
                {
                    Db.ClassifiedFavorites.Add(new ClassifiedFavorite { UserId = _myUid, AdId = Id, CreatedAt = DateTime.UtcNow });
                    await Db.SaveChangesAsync();
                }
                _favSaved = true;
            }
        }
        finally
        {
            _favBusy = false;
        }
    }

    private async Task SendChatAsync()
    {
        _chatErr = Shop.Shared.ContentFilter.ViolationMessage(_chatText);
        if (_chatErr is not null) return;

        // محدودیت نرخ
        lock (ChatLock)
        {
            if (_lastSent.TryGetValue(_myUid, out var last) && (DateTime.UtcNow - last).TotalSeconds < 20)
            {
                _chatErr = "کمی آهسته‌تر — بین پیام‌ها حداقل ۲۰ ثانیه فاصله بگذارید.";
                return;
            }
            _lastSent[_myUid] = DateTime.UtcNow;
        }

        _chatBusy = true;
        try
        {
            var auth = await AuthState.GetAuthenticationStateAsync();
            var uid = Guid.Parse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value);
            Db.ClassifiedChatMessages.Add(new ClassifiedChatMessage
            {
                AdId = Id,
                UserId = uid,
                Text = _chatText.Trim(),
                IsFromOwner = false,
                CreatedAt = DateTime.UtcNow
            });
            await Db.SaveChangesAsync();
            _chatSent = true;
            var ownerId = await Db.ClassifiedAds.Where(x => x.Id == Id).Select(x => (Guid?)x.UserId).FirstOrDefaultAsync();
            if (ownerId is not null)
                await Events.PublishNotificationAsync(new Application.Interfaces.NotificationEvent(
                    ownerId.Value, "💬 پیام جدید برای آگهی شما", _chatText.Trim(), "bi-chat-dots", $"/panel/ads/chat/{Id}"));
        }
        catch (Exception ex)
        {
            _chatErr = "خطا در ارسال: " + ex.Message;
        }
        finally
        {
            _chatBusy = false;
        }
    }

    private static List<(string, string)> ParseAttrs(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return [];
        try
        {
            using var doc = JsonDocument.Parse(json);
            return doc.RootElement.EnumerateArray()
                .Select(e => (e.GetProperty("name").GetString() ?? "", e.GetProperty("value").GetString() ?? ""))
                .Where(x => !string.IsNullOrWhiteSpace(x.Item2)).ToList();
        }
        catch { return []; }
    }
}
